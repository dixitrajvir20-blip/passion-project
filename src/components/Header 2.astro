---
import Logo from './Logo.astro';
import RegionTabs from './RegionTabs.astro';
import { site } from '../lib/site';

interface Props {
  /** Region code when inside an edition; links stay global without one. */
  region?: string;
  /** Sub-path the edition switch keeps when changing edition. */
  regionSub?: string;
  /** Per-edition sub-paths, where an edition lacks this page. */
  regionSubs?: Partial<Record<string, string>>;
  path?: string;
}

const { region, regionSub = '', regionSubs, path = '' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const prefix = region ? `${base}/${region}` : base;

const links = [
  { label: 'Learn', to: region ? `${prefix}/learn` : `${base}/#editions`, key: 'learn' },
  { label: 'Tools', to: region ? `${prefix}/tools` : `${base}/#calculators`, key: 'tools' },
  { label: 'Glossary', to: `${base}/glossary`, key: 'glossary', wide: true },
  { label: 'Dashboard', to: `${base}/dashboard`, key: 'dashboard' },
  { label: 'About', to: `${base}/about`, key: 'about', wide: true },
  { label: 'Search', to: `${base}/search`, key: 'search' },
];
---

<header class="site-header on-band" id="top">
  <div class="container header-inner">
    <a class="brand" href={region ? prefix : `${base}/`} aria-label={`${site.name} home`}>
      <Logo size={40} />
      <span class="wordmark">{site.name}</span>
    </a>
    <nav class="main-nav" aria-label="Main">
      <ul>
        {links.map((l) => (
          <li class={l.wide ? 'nav-wide' : undefined}>
            <a href={l.to} aria-current={path === l.key ? 'page' : undefined} data-astro-prefetch>{l.label}</a>
          </li>
        ))}
        {site.accountsEnabled && (
          <li><a href={`${base}/account`} aria-current={path === 'account' ? 'page' : undefined}>Sign in</a></li>
        )}
      </ul>
    </nav>
    <RegionTabs current={region} sub={regionSub} subs={regionSubs} />
  </div>
</header>

<style>
  /* The header sits on the dark-blue field: white wordmark, a white pill group for the site's
     sections, and the edition menu at the right. */
  .site-header { background: var(--band); position: relative; z-index: 40; }
  /* One row and sticky only from 1040px, where the six pills and the longest edition name fit
     beside the brand (they wrap below about 1020px). A one-row header is 72px, which is
     --header-h, and the scroll padding and sticky offsets are sized from it. Narrower, the nav
     takes its own row and the header scrolls away. */
  @media (min-width: 1040px) { .site-header { position: sticky; top: 0; } }

  .header-inner {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-areas: 'brand editions' 'nav nav';
    align-items: center;
    gap: var(--space-3) var(--space-3);
    padding-top: var(--space-3);
    padding-bottom: var(--space-3);
  }
  @media (min-width: 1040px) {
    .header-inner { grid-template-columns: auto 1fr auto; grid-template-areas: 'brand nav editions'; min-height: var(--header-h); }
  }
  .brand { grid-area: brand; display: inline-flex; align-items: center; gap: var(--space-3); color: var(--ink); text-decoration: none; min-height: 44px; }
  .wordmark { font-family: var(--font-display); font-weight: 800; font-size: var(--text-wordmark); letter-spacing: -0.02em; color: var(--ink); }
  @media (max-width: 559px) { .wordmark { display: none; } }
  .site-header :global(.region-tabs) { grid-area: editions; justify-self: end; }

  .main-nav { grid-area: nav; justify-self: start; }
  @media (min-width: 1040px) { .main-nav { justify-self: center; } }
  .main-nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    list-style: none;
    margin: 0;
    padding: var(--space-1);
    border-radius: var(--radius-pill);
  }
  .main-nav li { margin: 0; }
  @media (max-width: 419px) { .nav-wide { display: none; } }
  .main-nav ul { background: var(--paper); }
  .main-nav a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 var(--space-3);
    border-radius: var(--radius-pill);
    color: var(--brand-navy);
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 700;
    text-decoration: none;
  }
  @media (min-width: 640px) { .main-nav a { padding: 0 var(--space-4); } }
  .main-nav a:hover { background: var(--field-pale); }
  .main-nav a[aria-current='page'] { background: var(--gold-pale); color: var(--on-gold); }
  .main-nav a:focus-visible { outline-offset: 1px; }
</style>
