---
/**
 * Little monoline doodles that peek out from card edges, as Ivy Kids does with its drawings.
 * Money-and-business objects, not cartoon animals: the readers are 15 to 21. Navy line with one
 * gold spot; decoration only, hidden from assistive tech.
 */
interface Props {
  name: 'coin' | 'cup' | 'calculator' | 'plane' | 'tag' | 'phone';
  class?: string;
}
const { name, class: className = '' } = Astro.props;
---

<svg class:list={['doodle', className]} viewBox="0 0 48 48" aria-hidden="true" focusable="false">
  {name === 'coin' && (
    <g>
      <circle class="doodle-spot" cx="24" cy="24" r="15" />
      <circle cx="24" cy="24" r="15" />
      <circle cx="24" cy="24" r="10.5" />
      <path d="M24 17.5v13M20.5 21c0-2 1.6-3 3.5-3s3.5 1 3.5 2.8c0 3.7-7 2.5-7 6.4 0 1.8 1.6 2.8 3.5 2.8s3.5-1 3.5-3" />
    </g>
  )}
  {name === 'cup' && (
    <g>
      <path class="doodle-spot" d="M11 21h22v9c0 5-4 9-9 9h-4c-5 0-9-4-9-9z" />
      <path d="M11 21h22v9c0 5-4 9-9 9h-4c-5 0-9-4-9-9z M33 24h3c2.5 0 4 1.6 4 3.5S38.5 31 36 31h-3" />
      <path d="M17 16c-1.5-2 1.5-3.5 0-6M23 16c-1.5-2 1.5-3.5 0-6M29 16c-1.5-2 1.5-3.5 0-6" />
    </g>
  )}
  {name === 'calculator' && (
    <g>
      <rect class="doodle-spot" x="16" y="11" width="16" height="7" rx="1.5" />
      <rect x="12" y="6" width="24" height="36" rx="4" />
      <rect x="16" y="11" width="16" height="7" rx="1.5" />
      <path d="M17.5 25h1M23.5 25h1M29.5 25h1M17.5 31h1M23.5 31h1M29.5 31h1M17.5 37h1M23.5 37h1M29.5 37h1" />
    </g>
  )}
  {name === 'plane' && (
    <g>
      <path class="doodle-spot" d="M8 23l32-14-9 30-7-11z" />
      <path d="M8 23l32-14-9 30-7-11z M24 28L40 9 M24 28v9l4-5" />
    </g>
  )}
  {name === 'tag' && (
    <g>
      <path class="doodle-spot" d="M8 24V9h15l17 17-15 15z" />
      <path d="M8 24V9h15l17 17-15 15z" />
      <circle cx="15" cy="16" r="2.5" />
    </g>
  )}
  {name === 'phone' && (
    <g>
      <rect class="doodle-spot" x="18" y="16" width="12" height="12" rx="1" />
      <rect x="13" y="5" width="22" height="38" rx="4" />
      <path d="M18 16h5v5h-5zM25 16h5v5h-5zM18 23h5v5h-5zM26 24h4M26 27h2M21 38h6" />
    </g>
  )}
</svg>
