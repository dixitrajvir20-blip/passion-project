---
/**
 * Small flags for the edition menu. Drawn here, not fetched: no request, no emoji, and they render
 * the same on every phone. Flag colours are fixed by their countries, so, like the logo, they are
 * the one place raw hex is allowed outside tokens.css. Decorative: the region's name sits beside
 * each one as text.
 */
interface Props {
  code: 'in' | 'eu' | 'us';
  class?: string;
}
const { code, class: className = '' } = Astro.props;
const star = 'M0-1.6.47-.5H1.52L.68.19l.26 1.1L0 .62l-.94.67.26-1.1L-1.52-.5H-.47Z';
const ring = Array.from({ length: 12 }, (_, i) => {
  const a = (i / 12) * Math.PI * 2;
  return { x: 12 + 5 * Math.sin(a), y: 8 - 5 * Math.cos(a) };
});
---

<svg class:list={['flag', className]} viewBox="0 0 24 16" width="24" height="16" aria-hidden="true" focusable="false">
  {code === 'in' && (
    <g>
      <rect width="24" height="16" fill="#FFFFFF" />
      <rect width="24" height="5.33" fill="#FF9933" />
      <rect y="10.67" width="24" height="5.33" fill="#138808" />
      <circle cx="12" cy="8" r="2.1" fill="none" stroke="#000080" stroke-width="0.7" />
      <circle cx="12" cy="8" r="0.5" fill="#000080" />
    </g>
  )}
  {code === 'eu' && (
    <g>
      <rect width="24" height="16" fill="#003399" />
      {ring.map((p) => <path d={star} fill="#FFCC00" transform={`translate(${p.x.toFixed(2)} ${p.y.toFixed(2)}) scale(0.9)`} />)}
    </g>
  )}
  {code === 'us' && (
    <g>
      <rect width="24" height="16" fill="#FFFFFF" />
      {[0, 2, 4, 6, 8, 10, 12].map((i) => <rect y={i * (16 / 13)} width="24" height={16 / 13} fill="#B22234" />)}
      <rect width="10" height={16 * (7 / 13)} fill="#3C3B6E" />
      {[1, 3, 5, 7, 9].flatMap((x) => [1.4, 3.4, 5.4, 7.4].map((y) => <circle cx={x} cy={y} r="0.45" fill="#FFFFFF" />))}
    </g>
  )}
  <rect width="24" height="16" fill="none" stroke="#0B1240" stroke-opacity="0.25" stroke-width="0.5" />
</svg>
