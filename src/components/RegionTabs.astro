---
import { REGIONS } from '../lib/regions';

interface Props {
  current: string;
  /** Sub-path within the edition, so switching keeps you on the same kind of page. */
  sub?: string;
}

const { current, sub = '' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const tail = sub ? `/${sub}` : '';
---

<nav class="region-tabs" aria-label="Choose your edition">
  <div class="container">
    <ul>
      {REGIONS.map((region) => (
        <li>
          <a
            href={`${base}/${region.code}${tail}`}
            aria-current={region.code === current ? 'true' : undefined}
            data-region={region.code}
          >
            {region.tab}
          </a>
        </li>
      ))}
    </ul>
  </div>
</nav>

<script>
  // Remember the edition so the front page can offer it next time. Preference only:
  // exempt from consent (WP29 Opinion 04/2012; UK PECR preference exception).
  const current = document.querySelector('.region-tabs a[aria-current]');
  if (current instanceof HTMLElement && current.dataset.region) {
    try {
      window.localStorage.setItem('lp:region', current.dataset.region);
    } catch {
      // Blocked storage just means no memory of the choice.
    }
  }
</script>

<style>
  .region-tabs {
    background: var(--bg);
    padding: var(--space-3) 0 0;
  }
  ul {
    display: inline-flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    list-style: none;
    margin: 0;
    padding: var(--space-1);
    background: var(--bg-2);
    border-radius: var(--radius-pill);
  }
  li { margin: 0; }
  a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 var(--space-4);
    border-radius: var(--radius-pill);
    color: var(--ink-2);
    text-decoration: none;
    font-size: var(--text-sm);
    font-weight: 600;
    transition: background var(--dur-fast), color var(--dur-fast);
  }
  a:hover { color: var(--ink); background: var(--bg-3); }
  /* Weight and fill carry the state, not colour alone. */
  a[aria-current] {
    color: var(--ink);
    background: var(--bg);
    font-weight: 700;
  }
</style>
