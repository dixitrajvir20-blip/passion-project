---
/**
 * The edition line: a navy strip above the header, the way news sites switch between their UK,
 * US and international editions. It sits on every page so the switch is always in the same place
 * (WCAG 3.2.3); outside an edition nothing is current and each link opens that edition's front.
 */
import { REGIONS } from '../lib/regions';

interface Props {
  current?: string;
  /** Sub-path within the edition, so switching keeps you on the same kind of page. */
  sub?: string;
}

const { current, sub = '' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const tail = current && sub ? `/${sub}` : '';
---

<nav class="region-tabs section-dark" aria-label="Choose your edition">
  <div class="container edition-inner">
    <span class="edition-label" aria-hidden="true">Edition</span>
    <ul>
      {REGIONS.map((region) => (
        <li>
          <a
            href={`${base}/${region.code}${tail}`}
            aria-current={region.code === current ? 'true' : undefined}
            data-region={region.code}
          >
            {region.tab}
          </a>
        </li>
      ))}
    </ul>
  </div>
</nav>

<script>
  // Remember the edition so the front page can offer it next time. Preference only:
  // exempt from consent (WP29 Opinion 04/2012; UK PECR preference exception).
  const current = document.querySelector('.region-tabs a[aria-current]');
  if (current instanceof HTMLElement && current.dataset.region) {
    try {
      window.localStorage.setItem('lp:region', current.dataset.region);
    } catch {
      // Blocked storage just means no memory of the choice.
    }
  }
</script>

<style>
  .region-tabs { min-height: var(--edition-h); }
  .edition-inner { display: flex; align-items: center; gap: var(--space-4); }
  .edition-label { color: var(--muted); font-size: var(--text-sm); }
  @media (max-width: 379px) { .edition-label { display: none; } }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  @media (min-width: 640px) { ul { gap: 0 var(--space-5); } }
  li { margin: 0; }
  a {
    display: inline-flex;
    align-items: center;
    min-height: var(--edition-h);
    color: var(--ink-2);
    text-decoration: none;
    font-size: var(--text-sm);
    border-bottom: 3px solid transparent;
    padding-top: 3px;
  }
  a:hover { color: var(--ink); border-bottom-color: var(--line-strong); }
  /* Weight and a gold underline carry the state, not colour alone. */
  a[aria-current] { color: var(--ink); font-weight: 700; border-bottom-color: var(--gold); }
</style>
