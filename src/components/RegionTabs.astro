---
import { REGIONS } from '../lib/regions';

interface Props {
  current: string;
  /** Sub-path within the edition, so switching keeps you on the same kind of page. */
  sub?: string;
}

const { current, sub = '' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const tail = sub ? `/${sub}` : '';
---

<nav class="region-tabs" aria-label="Choose your edition">
  <ul>
    {REGIONS.map((region) => (
      <li>
        <a
          href={`${base}/${region.code}${tail}`}
          aria-current={region.code === current ? 'true' : undefined}
          data-region={region.code}
        >
          {region.tab}
        </a>
      </li>
    ))}
  </ul>
</nav>

<script>
  // Remember the edition so the front page can offer it next time.
  const current = document.querySelector('.region-tabs a[aria-current]');
  if (current instanceof HTMLElement && current.dataset.region) {
    try {
      window.localStorage.setItem('lp:region', current.dataset.region);
    } catch {
      // Blocked storage just means no memory of the choice.
    }
  }
</script>

<style>
  .region-tabs {
    border-bottom: 1px solid var(--line);
    background: var(--paper-2);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    list-style: none;
    margin: 0 auto;
    padding: 0 var(--space-5);
    max-width: 1120px;
  }

  a {
    display: inline-block;
    padding: var(--space-3) var(--space-4);
    min-height: 44px;
    color: var(--ink-2);
    text-decoration: none;
    font-size: 16px;
    border-bottom: 3px solid transparent;
  }

  a:hover {
    color: var(--ink);
    background: var(--paper);
  }

  /* Weight and underline carry the state, not colour alone. */
  a[aria-current] {
    color: var(--ink);
    font-weight: 700;
    border-bottom-color: var(--accent);
    background: var(--paper);
  }
</style>
