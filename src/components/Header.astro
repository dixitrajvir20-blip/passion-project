---
import Logo from './Logo.astro';
import { site } from '../lib/site';

interface Props {
  /** Region code when inside an edition; links stay global without one. */
  region?: string;
  path?: string;
}

const { region, path = '' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const prefix = region ? `${base}/${region}` : base;

const links = region
  ? [
      { label: 'Learn', to: `${prefix}/learn`, key: 'learn' },
      { label: 'Tools', to: `${prefix}/tools`, key: 'tools' },
      { label: 'Glossary', to: `${base}/glossary`, key: 'glossary' },
      // Five items do not fit a 360px row; About is also in the footer, so it yields on phones.
      { label: 'About', to: `${base}/about`, key: 'about', wide: true },
      { label: 'Search', to: `${base}/search`, key: 'search' },
    ]
  : [
      { label: 'Glossary', to: `${base}/glossary`, key: 'glossary' },
      { label: 'About', to: `${base}/about`, key: 'about' },
      { label: 'Search', to: `${base}/search`, key: 'search' },
    ];
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={region ? prefix : `${base}/`} aria-label={`${site.name} home`}>
      <Logo size={32} />
      <span class="wordmark">{site.name}</span>
    </a>
    <nav aria-label="Main">
      <ul>
        {links.map((l) => (
          <li class={'wide' in l && l.wide ? 'nav-wide' : undefined}>
            <a href={l.to} aria-current={path === l.key ? 'page' : undefined} data-astro-prefetch>
              {l.label}
            </a>
          </li>
        ))}
        {site.accountsEnabled && (
          <li class="nav-account">
            <a class="btn btn-secondary btn-sm" href={`${base}/account`} aria-current={path === 'account' ? 'page' : undefined}>
              Sign in
            </a>
          </li>
        )}
      </ul>
    </nav>
  </div>
</header>

<style>
  /* A solid bar, not a frosted one: backdrop blur is expensive to repaint on the budget Android
     phones this site is built for, and a plain edge reads as paper rather than as an app. */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    height: var(--header-h);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--ink);
    text-decoration: none;
    padding: var(--space-2) 0;
    min-height: 44px;
  }
  .wordmark {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--text-wordmark);
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  /* On narrow screens the badge alone is the brand, so the whole nav fits on one row. */
  @media (max-width: 639px) { .wordmark { display: none; } }

  nav ul {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  @media (min-width: 640px) { nav ul { gap: var(--space-5); } }
  nav li { margin: 0; }
  @media (max-width: 479px) { .nav-wide { display: none; } }

  nav a:not(.btn) {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--ink-2);
    text-decoration: none;
    font-size: var(--text-sm);
    font-weight: 400;
    transition: color var(--dur-fast);
  }
  nav a:not(.btn):hover { color: var(--ink); }
  nav a:not(.btn)[aria-current='page'] {
    color: var(--ink);
    font-weight: 700;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 8px;
    text-decoration-color: var(--accent);
  }
  .nav-account { margin-left: var(--space-2); }
</style>
