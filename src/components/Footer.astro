---
import Logo from './Logo.astro';
import { REGIONS } from '../lib/regions';
import { site } from '../lib/site';

interface Props {
  region?: string;
}

const { region } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const prefix = region ? `${base}/${region}` : base;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a class="brand" href={`${base}/`} aria-label={`${site.name} home`}>
          <Logo size={32} />
          <span class="wordmark">{site.name}</span>
        </a>
        <p class="footer-blurb">
          Free lessons on money and business for ages 15 to 21. It started as a school club and
          is built in the open, with nothing to sell.
        </p>
      </div>

      <nav aria-label="Editions">
        <h2 class="footer-head">Editions</h2>
        <ul>
          {REGIONS.map((r) => (
            <li><a href={`${base}/${r.code}`} aria-current={r.code === region ? 'true' : undefined}>{r.name}</a></li>
          ))}
        </ul>
      </nav>

      <nav aria-label="Site">
        <h2 class="footer-head">Site</h2>
        <ul>
          {region && <li><a href={`${prefix}/learn`}>Learn</a></li>}
          {region && <li><a href={`${prefix}/tools`}>Tools</a></li>}
          <li><a href={`${base}/glossary`}>Glossary</a></li>
          <li><a href={`${base}/about`}>About</a></li>
          <li><a href={`${base}/write`}>Write for us</a></li>
          {site.accountsEnabled && <li><a href={`${base}/account`}>Sign in</a></li>}
          <li><a href={site.repo} rel="noopener noreferrer">Source code</a></li>
        </ul>
      </nav>

      <nav aria-label="Legal">
        <h2 class="footer-head">Legal</h2>
        <ul>
          <li><a href={`${base}/privacy`}>Privacy</a></li>
          <li><a href={`${base}/cookies`}>Cookies &amp; storage</a></li>
          <li><a href={`${base}/terms`}>Terms</a></li>
          <li><a href={`${base}/accessibility`}>Accessibility</a></li>
          <li><a href={`${base}/disclaimer`}>Disclaimer</a></li>
          <li>
            <button type="button" class="linklike" data-open-consent>Privacy choices</button>
          </li>
        </ul>
      </nav>
    </div>

    <div class="footer-base">
      <p>For learning only. Not financial, legal, or tax advice.</p>
      <p>© {year} {site.owner}. Text is CC BY-NC-SA 4.0; code is MIT.</p>
    </div>
  </div>
</footer>

<style>
  /* White, under a 1px rule: the header bar stays the page's only blue block. */
  .site-footer {
    padding: var(--space-7) 0 var(--space-6);
    border-top: var(--rule-w) solid var(--rule);
    background: var(--bg);
    color: var(--ink-2);
  }
  .footer-grid {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 640px) {
    .footer-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .footer-brand { grid-column: 1 / -1; }
  }
  @media (min-width: 1024px) {
    .footer-grid { grid-template-columns: 2fr 1fr 1fr 1fr; gap: var(--space-7); }
    .footer-brand { grid-column: auto; }
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-height: var(--target);
    margin-bottom: var(--space-2);
    color: var(--ink);
    text-decoration: none;
  }
  .brand :global(svg) { flex: none; }
  .brand:hover .wordmark { text-decoration: underline; text-decoration-thickness: var(--control-w); text-underline-offset: 0.16em; }
  .wordmark { color: var(--ink); font-size: var(--text-lg); font-weight: 700; line-height: var(--leading-heading); letter-spacing: 0; }
  .footer-blurb { max-width: 36ch; margin: 0; color: var(--muted); font-size: var(--text-sm); }

  .footer-head {
    margin: 0 0 var(--space-2);
    color: var(--ink);
    font-size: var(--text-sm);
    font-weight: 700;
    line-height: var(--leading-ui);
    letter-spacing: 0;
  }
  ul { list-style: none; margin: 0; padding: 0; }
  li { margin: 0; }
  /* Rows of 44px, so the /accessibility page's claim about lists of links holds. */
  li a, .linklike {
    display: flex;
    align-items: center;
    min-height: var(--target);
    color: var(--ink-2);
    font-size: var(--text-sm);
    line-height: var(--leading-ui);
    text-decoration: none;
  }
  li a:hover, .linklike:hover { color: var(--ink); text-decoration: underline; text-decoration-thickness: var(--control-w); text-underline-offset: 0.16em; }
  li a[aria-current] { color: var(--ink); font-weight: 700; }
  .linklike { width: 100%; padding: 0; border: 0; background: none; font-family: var(--font-body); text-align: start; cursor: pointer; }

  .footer-base {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    justify-content: space-between;
    margin-top: var(--space-7);
    padding-top: var(--space-4);
    border-top: var(--rule-w) solid var(--rule);
  }
  .footer-base p { margin: 0; color: var(--muted); font-size: var(--text-xs); }
</style>
