---
import Logo from './Logo.astro';
import { REGIONS } from '../lib/regions';
import { site } from '../lib/site';

interface Props {
  region?: string;
}

const { region } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const prefix = region ? `${base}/${region}` : base;
const year = new Date().getFullYear();
---

<footer class="site-footer section-dark">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a class="brand" href={`${base}/`} aria-label={`${site.name} home`}>
          <Logo size={36} />
          <span class="wordmark">{site.name}</span>
        </a>
        <p class="small">
          Free lessons on money and business for ages 15 to 21. It started as a school club and
          is built in the open, with nothing to sell.
        </p>
      </div>

      <nav aria-label="Editions">
        <h2 class="footer-head">Editions</h2>
        <ul>
          {REGIONS.map((r) => (
            <li><a href={`${base}/${r.code}`} aria-current={r.code === region ? 'true' : undefined}>{r.name}</a></li>
          ))}
        </ul>
      </nav>

      <nav aria-label="Site">
        <h2 class="footer-head">Site</h2>
        <ul>
          {region && <li><a href={`${prefix}/learn`}>Learn</a></li>}
          {region && <li><a href={`${prefix}/tools`}>Tools</a></li>}
          <li><a href={`${base}/glossary`}>Glossary</a></li>
          <li><a href={`${base}/about`}>About</a></li>
          <li><a href={`${base}/write`}>Write for us</a></li>
          {site.accountsEnabled && <li><a href={`${base}/account`}>Sign in</a></li>}
          <li><a href={site.repo} rel="noopener noreferrer">Source code</a></li>
        </ul>
      </nav>

      <nav aria-label="Legal">
        <h2 class="footer-head">Legal</h2>
        <ul>
          <li><a href={`${base}/privacy`}>Privacy</a></li>
          <li><a href={`${base}/cookies`}>Cookies &amp; storage</a></li>
          <li><a href={`${base}/terms`}>Terms</a></li>
          <li><a href={`${base}/accessibility`}>Accessibility</a></li>
          <li><a href={`${base}/disclaimer`}>Disclaimer</a></li>
          <li>
            <button type="button" class="linklike" data-open-consent>Privacy choices</button>
          </li>
        </ul>
      </nav>
    </div>

    <div class="footer-base">
      <p class="small muted">For learning only. Not financial, legal, or tax advice.</p>
      <p class="small muted">© {year} {site.owner}. Text is CC BY-NC-SA 4.0; code is MIT.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--bg);
    padding: var(--space-8) 0 var(--space-6);
    margin-top: var(--space-7);
  }
  .footer-grid {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) { .footer-grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 980px) { .footer-grid { grid-template-columns: 2fr 1fr 1fr 1fr; gap: var(--space-8); } }

  .brand { display: inline-flex; align-items: center; gap: var(--space-3); text-decoration: none; color: var(--ink); margin-bottom: var(--space-3); }
  .wordmark { font-family: var(--font-display); font-weight: 800; font-size: var(--text-wordmark); letter-spacing: -0.02em; }
  .footer-brand p { max-width: 36ch; }

  .footer-head {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--ink);
    margin: 0 0 var(--space-3);
    letter-spacing: 0;
  }
  ul { list-style: none; margin: 0; padding: 0; }
  li { margin: 0; }
  li a, .linklike {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    color: var(--ink-2);
    font-size: var(--text-sm);
    text-decoration: none;
  }
  li a:hover, .linklike:hover { color: var(--ink); text-decoration: underline; }
  li a[aria-current] { color: var(--ink); font-weight: 700; }
  .linklike { background: none; border: 0; padding: 0; font-family: var(--font-body); cursor: pointer; }

  .footer-base {
    margin-top: var(--space-7);
    padding-top: var(--space-4);
    border-top: 1px solid var(--line);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    justify-content: space-between;
  }
  .footer-base p { margin: 0; }
</style>
