---
/**
 * The calculation, taught one line at a time. The reader presses "Show line N" (a small secondary
 * button) and each line arrives with a one-sentence caption: what it is, who gets it. The lines
 * sit on the page as a plain ledger, no box; the last is the answer, closed with the ledger's
 * double rule. The lines come from lesson-math, never from prose, so the arithmetic on screen is
 * the arithmetic in finance.ts.
 *
 * "Show every line" (script) opens the chain for readers who want the whole ledger; printing
 * opens it too. With JavaScript off the chain still works line by line.
 */
import ShowMeStep from './ShowMeStep.astro';
import type { Step } from '../../lib/lesson-math';

interface Props {
  context: string;
  steps: Step[];
  localeCode: string;
}

const { context, steps, localeCode } = Astro.props;
---

<div class="showme" data-showme>
  <p class="showme-context">{context}</p>
  <p class="showme-controls">
    <button type="button" class="showme-all btn-link btn-sm" data-showme-all hidden>Show every line</button>
  </p>
  <ol class="ledger showme-lines">
    <ShowMeStep steps={steps} index={0} total={steps.length} localeCode={localeCode} />
  </ol>
</div>

<script>
  const openAll = (root: Element) => root.querySelectorAll<HTMLDetailsElement>('details.showme-more').forEach((d) => (d.open = true));
  for (const root of document.querySelectorAll<HTMLElement>('[data-showme]')) {
    const all = root.querySelector<HTMLButtonElement>('[data-showme-all]');
    if (!all) continue;
    all.hidden = false;
    all.addEventListener('click', () => {
      openAll(root);
      all.hidden = true;
    });
  }
  window.addEventListener('beforeprint', () => document.querySelectorAll<HTMLElement>('[data-showme]').forEach(openAll));
</script>
