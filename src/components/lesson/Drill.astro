---
/**
 * A run of situations, each a mock screen and a decision. It is the poll repeated, not an island:
 * nothing here needs JavaScript. Each situation joins the review queue, because a scam you have
 * met once is forgotten about as fast as any other fact.
 */
import MockScreen from './MockScreen.astro';
import Poll from './Poll.astro';

interface Scenario {
  screen: { kind: 'request' | 'message' | 'call' | 'chat' | 'qr'; from: string; lines: string[]; amount?: number; action?: string };
  check: { q: string; options: { text: string; why: string }[]; answer: number };
}

interface Props {
  lessonId: string;
  intro: string;
  scenarios: Scenario[];
  reflection: string;
  localeCode: string;
}

const { lessonId, intro, scenarios, reflection, localeCode } = Astro.props;
---

<div class="drill">
  <p>{intro}</p>
  <ol class="drill-list">
    {scenarios.map((scenario, index) => (
      <li>
        <p class="drill-count">Situation {index + 1} of {scenarios.length}</p>
        <MockScreen {...scenario.screen} localeCode={localeCode} />
        <Poll
          id={`drill-${index + 1}`}
          question={scenario.check.q}
          options={scenario.check.options}
          answer={scenario.check.answer}
          checkId={`${lessonId}#d${index + 1}`}
          revealLabel="Show what it was"
        />
      </li>
    ))}
  </ol>
  <p class="reflection">{reflection}</p>
</div>
