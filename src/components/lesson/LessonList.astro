---
/**
 * A track's lessons. Published ones are links with two quiet marks (read, checks done) filled in
 * from this device's progress; planned ones are plain text, not tappable-looking tiles, so a
 * screen-reader user does not meet a run of dead stops. The number is the lesson's place in the
 * track (a real sequence), shown as type; the <ol> already gives it to screen readers.
 */
import { lessonPath, type Lesson } from '../../lib/lessons';

interface Props {
  lessons: Lesson[];
  planned: string[];
  /** Title and time only, for the edition front where three tracks sit side by side. */
  compact?: boolean;
}

const { lessons, planned, compact = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<ol class:list={['lesson-list', { 'is-compact': compact }]}>
  {lessons.map((lesson, index) => (
    <li>
      <a class="lesson-row" href={`${base}/${lessonPath(lesson)}`} data-lesson-row={lesson.id}>
        <span class="lesson-num numbers" aria-hidden="true">{index + 1}</span>
        <span class="lesson-title">{lesson.data.title}</span>
        {!compact && <span class="lesson-sub">{lesson.data.summary}</span>}
        <span class="lesson-marks">
          {lesson.data.readingMinutes} min
          <span data-mark="read" hidden> · Read</span>
          <span data-mark="checks" hidden> · Checks done</span>
        </span>
      </a>
    </li>
  ))}
  {planned.map((title, index) => (
    <li class="lesson-planned">
      <span class="lesson-num numbers" aria-hidden="true">{lessons.length + index + 1}</span>
      <span>{title} <span class="muted">(being written)</span></span>
    </li>
  ))}
</ol>
