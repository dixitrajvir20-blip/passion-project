---
/**
 * One edition's break-even example, set as a ledger: price, cost, what is kept (double rule),
 * then the sentence it adds up to. Computed from finance.ts with the edition's own calculator
 * defaults, so the page and the calculator can never disagree.
 */
import { breakEven } from '../lib/finance';
import { money, number, localeByCode } from '../lib/format';
import type { Region } from '../lib/regions';

interface Props {
  region: Region;
}

const { region } = Astro.props;
const s = region.breakEven;
const locale = localeByCode(region.locale);
const [fixed, variable, price] = [s.fixed, s.variable, s.price].map(Number);
const result = breakEven(fixed, variable, price);
const one = s.unitName.replace(/s$/, '');
---

<figure class="sum">
  <figcaption class="sum-title">{s.scenario}</figcaption>
  <ol class="ledger">
    <li class="ledger-row"><span class="ledger-label">Charged per {one}</span><span class="ledger-figure">{money(price, locale)}</span></li>
    <li class="ledger-row"><span class="ledger-label">Spent on each {one}</span><span class="ledger-figure">−{money(variable, locale)}</span></li>
    <li class="ledger-row ledger-total"><span class="ledger-label">Kept per {one}</span><span class="ledger-figure">{money(result.contributionMargin, locale)}</span></li>
  </ol>
  {result.viable && (
    <p class="sum-result">
      With {money(fixed, locale)} of fixed costs every month, it needs{' '}
      <strong>{number(result.units!, locale)} {s.unitName}</strong> before it makes any profit.
    </p>
  )}
</figure>

<style>
  .sum { margin: 0; }
  .sum-title { color: var(--muted); font-size: var(--text-sm); }
  .sum .ledger { margin: var(--space-2) 0 var(--space-4); }
  .sum .ledger-row { padding: var(--space-2) 0; }
  .sum .ledger-total { padding-top: var(--space-3); }
  .sum-result { font-size: var(--text-ui); margin: 0; }
</style>
