---
/**
 * The Business Lab badge. INTERIM: a plain blue disc with a white B cut from Bricolage Grotesque
 * 800 (the B is a drawn path, so the typeface is not loaded), standing in until the licensed logo
 * file replaces it (docs/BRAND_GUIDE.md §4). Swap the drawing below for the licensed SVG and every
 * page, the favicon script and the share images follow. Inline so it needs no request.
 *
 * Two versions of the same drawing, nothing recoloured:
 * - default: a #0C61C4 disc with a white ring and B (the footer, the favicon, the app icons);
 * - inverse: a white disc with a #0C61C4 ring and B, for the blue bar, so the badge never sits blue
 *   on blue (the disc is 8.35:1 against the bar; the B is 5.96:1 on the disc).
 * The raw hex stays here, the one allowed place besides Flag.astro.
 */
interface Props {
  size?: number;
  /** Decorative when the wordmark sits next to it; labelled when used alone. */
  labelled?: boolean;
  variant?: 'default' | 'inverse';
  class?: string;
}
const { size = 28, labelled = false, variant = 'default', class: className = '' } = Astro.props;
const disc = variant === 'inverse' ? '#FFFFFF' : '#0C61C4';
const mark = variant === 'inverse' ? '#0C61C4' : '#FFFFFF';
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 64 64"
  role={labelled ? 'img' : undefined}
  aria-hidden={labelled ? undefined : 'true'}
  aria-label={labelled ? 'Business Lab' : undefined}
  focusable="false"
>
  <circle cx="32" cy="32" r="32" fill={disc} />
  <circle cx="32" cy="32" r="27.5" fill="none" stroke={mark} stroke-width="1.5" />
  <path
    fill={mark}
    transform="translate(16.5 47) scale(0.04545 -0.04545)"
    d="M57 0L57 660L334 660Q396 660 444.5 649.5Q493 639 527.5 617.5Q562 596 580 563Q598 530 598 485Q598 446 581.5 415.5Q565 385 529 366.5Q493 348 435 342L435 329Q533 323 579 282Q625 241 625 173Q625 115 594.5 77Q564 39 505 19.5Q446 0 359 0ZM214 129L353 129Q409 129 437.5 147Q466 165 466 201Q466 241 432.5 261Q399 281 331 281L214 281ZM214 384L312 384Q377 384 408.5 403.5Q440 423 440 461Q440 498 411 515.5Q382 533 324 533L214 533Z"
  />
</svg>
