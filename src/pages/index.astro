---
import BaseLayout from '../layouts/BaseLayout.astro';
import EditionSum from '../components/EditionSum.astro';
import Flag from '../components/Flag.astro';
import { REGIONS, getRegion } from '../lib/regions';
import { GROUPS, TOOLS, type ToolMeta } from '../lib/tools';
import { toolAvailable } from '../lib/drills';
import { site } from '../lib/site';
import { lessonPath, lessonsFor } from '../lib/lessons';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// "Start with these": the first money-basics and how-business-works lesson of each edition.
const starters = (
  await Promise.all(
    REGIONS.map(async (region) => {
      const lessons = await lessonsFor(region.code);
      return ['money-basics', 'how-business-works']
        .map((track) => lessons.find((lesson) => lesson.data.track === track))
        .filter((lesson) => lesson !== undefined)
        .map((lesson) => ({ region, lesson }));
    }),
  )
).flat();
// One question per life moment that every edition can answer: the first all-edition tool of each
// group that every edition has ready (a drill only when every edition has its bank). Each link goes
// through the reader's edition.
const inEvery = async (tool: ToolMeta) =>
  (await Promise.all(REGIONS.map((region) => toolAvailable(region.code, tool.slug)))).every(Boolean);
const everywhere: ToolMeta[] = [];
for (const group of GROUPS) {
  for (const tool of TOOLS.filter((t) => t.group === group.id && !t.regions)) {
    if (await inEvery(tool)) {
      everywhere.push(tool);
      break;
    }
  }
}
const reasons = ['Free, with nothing to sell', 'No ads and no tracking', 'No sign-up needed', 'Real numbers in your currency', 'A source and a date on every figure', 'Built to load on a cheap phone'];
const india = getRegion('in');
---

<BaseLayout title={`${site.name} — ${site.tagline}`} description={site.description}>
  <div class="container home">
    <div class="front">
      <section class="intro" aria-labelledby="home-h">
        <h1 id="home-h">Money and business, taught for where you live.</h1>
        <p class="lede">
          Free lessons and calculators for ages 15 to 21. Each edition has its own currency, payment
          apps, rules and scams, because a lesson about money only helps if it is about your money.
        </p>
        <div class="btn-row">
          {/* The one primary button. It opens the edition list; once this device has chosen an
              edition, the script below turns it into "Continue with <edition>". */}
          <p class="resume" id="resume"><a class="btn" id="resume-link" href="#editions">Choose your edition</a></p>
          <a class="btn-link" href="#calculators">Try a tool</a>
        </div>
      </section>

      <section id="editions" class="editions" aria-labelledby="editions-h">
        <h2 id="editions-h">Choose your edition</h2>
        <ul class="index-list">
          {REGIONS.map((region) => (
            <li>
              <a class="index-row" href={`${base}/${region.code}`} data-astro-prefetch>
                <Flag code={region.code as 'in' | 'eu' | 'us'} class="index-flag" />
                <h3 class="index-title">{region.name} edition</h3>
                <span class="index-meta">{[region.currency, ...region.tags].join(' · ')}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>

      <figure class="box example-box">
        <figcaption class="example-label">A worked example</figcaption>
        <EditionSum region={india} />
      </figure>
    </div>

    <section id="how" class="column" aria-labelledby="steps-h">
      <h2 id="steps-h">How a lesson works</h2>
      <ol class="how-list">
        <li><h3>Start from the real thing</h3><p>A payslip, a loan sheet, a payment screen, drawn line by line. Find the line that matters before anyone explains it.</p></li>
        <li><h3>Watch, then see it worked</h3><p>A short video from a regulator or a teacher, then the calculation one line at a time, each line explained.</p></li>
        <li><h3>Your turn, then change one thing</h3><p>The same sum with new numbers and three hints, then the levers, to see what moves the answer.</p></li>
        <li><h3>Check your understanding</h3><p>Three questions, which come back for review a few days later.</p></li>
      </ol>
    </section>

    <section id="calculators" class="column taxonomy" aria-labelledby="calc-h">
      <h2 id="calc-h" class="taxonomy-title">Tools that answer</h2>
      <ul class="index-list taxonomy-list">
        {everywhere.map((tool) => (
          <li><a class="index-row" href="#editions" data-edition-path={`tools/${tool.slug}`}><span class="index-title">{tool.short}</span></a></li>
        ))}
      </ul>
      <p class="taxonomy-foot">Nothing you type leaves your phone.</p>
    </section>

    <section class="column why" aria-labelledby="why-h">
      <h2 id="why-h">Why {site.name}</h2>
      <p>
        Most people learn money at home, if at all. {site.name} grew out of a school club built on
        one idea, that business is a life skill, and this site is for everyone who has no one to ask.
      </p>
      <ul class="why-list">
        {reasons.map((reason) => <li>{reason}</li>)}
      </ul>
      <p class="why-more"><a class="btn-link" href={`${base}/about`}>More about {site.name}</a></p>
    </section>

    {starters.length > 0 && (
      <section class="column" aria-labelledby="start-h">
        <h2 id="start-h">Start with these</h2>
        <ul class="index-list">
          {starters.map(({ region, lesson }) => (
            <li>
              <a class="index-row" href={`${base}/${lessonPath(lesson)}`}>
                <h3 class="index-title">{lesson.data.title}</h3>
                <span class="index-sub">{lesson.data.summary}</span>
                <span class="index-meta">{region.name} · {lesson.data.readingMinutes} min</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>
</BaseLayout>

<script>
  // Offer the last edition rather than redirecting: a guess that moves people
  // without asking is the wrong default for a site about not being steered.
  try {
    const saved = window.localStorage.getItem('lp:region');
    const names: Record<string, string> = { in: 'India', eu: 'Europe', us: 'United States' };
    // Object.hasOwn, not `in`: a stored value is untrusted and `in` walks the prototype chain.
    if (saved && Object.hasOwn(names, saved)) {
      const wrap = document.getElementById('resume');
      const link = document.getElementById('resume-link');
      if (wrap && link instanceof HTMLAnchorElement) {
        link.href = new URL(saved, document.baseURI).pathname;
        link.textContent = `Continue with ${names[saved]}`;
        wrap.hidden = false;
      }
      // Links that default to the chooser go straight to the edition the reader already picked.
      for (const el of document.querySelectorAll<HTMLAnchorElement>('a[data-edition-path]')) {
        el.href = new URL(`${saved}/${el.dataset.editionPath}`, document.baseURI).pathname;
      }
    }
  } catch {
    // No stored preference available; the three choices above still work.
  }
</script>

<style>
  /* Flush left on white. Below 1024px one column in reading order: the intro, the editions, the
     worked example. From 1024px the worked example sits beside the intro and the editions, so the
     ledger and the choice of edition are both on the first screen. */
  .home { padding-block: var(--space-section); }
  .front { display: grid; grid-template-columns: minmax(0, 1fr); row-gap: var(--space-section); align-items: start; }
  @media (min-width: 1024px) {
    .front { grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); column-gap: var(--space-6); }
    .intro, .editions { grid-column: 1; }
    .example-box { grid-column: 2; grid-row: 1 / span 2; }
  }
  .home > section { margin-top: var(--space-section); }

  .intro h1 { font-size: var(--text-display); max-width: 15ch; }
  .intro .lede { margin-bottom: var(--space-5); }
  .resume { margin: 0; }

  .example-box { margin: 0; max-width: var(--measure); }
  .example-label { margin: 0 0 var(--space-2); color: var(--muted); font-size: var(--text-sm); font-weight: 700; }

  /* How a lesson works: the list numbers the steps. */
  .how-list { margin: 0; padding-inline-start: var(--space-5); }
  .how-list li { margin: 0 0 var(--space-5); padding-inline-start: var(--space-1); }
  .how-list li:last-child { margin-bottom: 0; }
  .how-list li::marker { color: var(--ink); font-size: var(--text-lg); font-weight: 700; }
  .how-list h3 { margin: 0 0 var(--space-1); }
  .how-list p { margin: 0; }

  .taxonomy-foot { margin: var(--space-4) 0 0; color: var(--muted); }

  .why-list { padding-inline-start: var(--space-5); }
  .why-list li { margin-bottom: var(--space-1); }
  .why-more { margin: 0; }
</style>
