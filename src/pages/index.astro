---
import BaseLayout from '../layouts/BaseLayout.astro';
import EditionSum from '../components/EditionSum.astro';
import { REGIONS } from '../lib/regions';
import { TOOLS } from '../lib/tools';
import { site } from '../lib/site';
import { lessonPath, lessonsFor } from '../lib/lessons';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// "Start here": the first lesson of each track, so the front page shows what an edition
// actually teaches instead of describing it. Tracks with nothing published yet show the
// planned title as plain text.
const editions = await Promise.all(
  REGIONS.map(async (region) => {
    const lessons = await lessonsFor(region.code);
    const start = region.tracks.map((track) => {
      const first = lessons.find((lesson) => lesson.data.track === track.slug);
      return first
        ? { title: first.data.title, href: `${base}/${lessonPath(first)}`, minutes: first.data.readingMinutes }
        : { title: track.planned[0] ?? track.title, href: undefined, minutes: undefined };
    });
    return { region, start, count: lessons.length };
  }),
);
const everywhere = TOOLS.filter((tool) => !tool.regions);
---

<BaseLayout title={`${site.name} — ${site.tagline}`} description={site.description}>
  <section class="intro">
    <div class="container">
      <h1>Money and business, taught for where you live.</h1>
      <p class="lede">
        Free lessons and calculators for ages 15 to 21. Each edition has its own currency, payment
        systems, rules and scams, because a lesson about money only helps if it is about your money.
        No ads, no sign-up, nothing to sell.
      </p>
    </div>
  </section>

  <section id="editions" class="editions-section" aria-labelledby="editions-h">
    <div class="container">
      <div class="editions-head">
        <h2 id="editions-h">Choose your edition</h2>
        <p class="resume" id="resume" hidden>
          <a id="resume-link" href={`${base}/`}>Continue where you left off</a>
        </p>
      </div>

      <ul class="list-plain editions">
        {editions.map(({ region, start }) => (
          <li class="edition">
            <h3 class="edition-name"><a href={`${base}/${region.code}`} data-astro-prefetch>{region.name}</a></h3>
            <p class="edition-problem">{region.problem}</p>

            <EditionSum region={region} />

            <h4 class="start-head">Start here</h4>
            <ol class="start-list">
              {start.map((item) => (
                <li>
                  {item.href ? (
                    <a href={item.href}>{item.title}</a>
                  ) : (
                    <span class="muted">{item.title} (being written)</span>
                  )}
                  {item.minutes && <span class="start-min numbers"> {item.minutes} min</span>}
                </li>
              ))}
            </ol>

            <a class="btn" href={`${base}/${region.code}`}>Open the {region.name} edition</a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section tools-section" aria-labelledby="tools-h">
    <div class="container split">
      <div>
        <h2 id="tools-h">Questions the calculators answer</h2>
        <p>
          Put your own numbers in. Every result shows the working underneath it, and nothing you
          type leaves your phone.
        </p>
      </div>
      <ul class="index-list">
        {everywhere.map((tool) => (
          <li>
            <a class="index-row" href="#editions" data-edition-path={`tools/${tool.slug}`}>
              <span class="index-title">{tool.answers}</span>
              <span class="index-sub">{tool.title}</span>
              <span class="index-go" aria-hidden="true">Open</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section why" aria-labelledby="why-h">
    <div class="container split">
      <div>
        <h2 id="why-h">Why this exists</h2>
      </div>
      <div class="why-body">
        <p class="lede">
          Most people learn money at home. If your family knows how it works, you pick it up. If
          not, school rarely fills the gap, and most money advice online is attached to something
          for sale.
        </p>
        <p>
          {site.name} started as a school club built on one idea: business is a life skill. This
          site takes that idea from one school to anyone with a phone.
        </p>
        <ul class="rules">
          <li>No ads, no sign-up and no tracking.</li>
          <li>No tips on what to buy or sell, and no promised returns.</li>
          <li>Every figure carries its source and a date.</li>
          <li>Built to load on a cheap phone over a slow connection.</li>
        </ul>
        <p><a href={`${base}/about`}>More about {site.name}</a></p>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Offer the last edition rather than redirecting: a guess that moves people
  // without asking is the wrong default for a site about not being steered.
  try {
    const saved = window.localStorage.getItem('lp:region');
    const names: Record<string, string> = { in: 'India', eu: 'Europe', us: 'United States' };
    // Object.hasOwn, not `in`: a stored value is untrusted and `in` walks the prototype chain.
    if (saved && Object.hasOwn(names, saved)) {
      const wrap = document.getElementById('resume');
      const link = document.getElementById('resume-link');
      if (wrap && link instanceof HTMLAnchorElement) {
        link.href = new URL(saved, document.baseURI).pathname;
        link.textContent = `Continue with the ${names[saved]} edition`;
        wrap.hidden = false;
      }
      // Links that default to the chooser go straight to the edition the reader already picked.
      for (const el of document.querySelectorAll<HTMLAnchorElement>('a[data-edition-path]')) {
        el.href = new URL(`${saved}/${el.dataset.editionPath}`, document.baseURI).pathname;
      }
    }
  } catch {
    // No stored preference available; the three choices above still work.
  }
</script>

<style>
  .intro { padding: var(--space-8) 0 var(--space-7); }
  @media (min-width: 900px) { .intro { padding: var(--space-9) 0 var(--space-8); } }
  .intro h1 { font-size: var(--text-h1); max-width: 16ch; margin-bottom: var(--space-5); }
  @media (min-width: 640px) { .intro h1 { font-size: var(--text-display); } }
  .intro .lede { max-width: 58ch; margin: 0; }

  .editions-section { padding-bottom: var(--space-8); }
  .editions-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: var(--space-2) var(--space-5); border-top: 2px solid var(--ink); padding-top: var(--space-4); }
  .editions-head h2 { margin: 0; font-size: var(--text-h3); }
  .resume { margin: 0; font-weight: 700; }

  .editions { display: grid; gap: 0; margin: var(--space-5) 0 0; }
  .edition { display: flex; flex-direction: column; gap: var(--space-4); margin: 0; padding: var(--space-6) 0; border-bottom: 1px solid var(--line); }
  /* Side by side, each edition's name, sentence, sum, list and button sit on shared rows, so the
     three ledgers line up and can be read across like columns of one cash book. */
  @media (min-width: 980px) {
    .editions { grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: var(--space-7); }
    .edition { border-bottom: 0; padding: var(--space-4) 0 0; }
    @supports (grid-template-rows: subgrid) {
      .editions { grid-template-rows: repeat(6, auto); }
      .edition { display: grid; grid-row: span 6; grid-template-rows: subgrid; row-gap: var(--space-4); align-content: start; }
      .edition-problem { min-height: 0; }
    }
  }
  .edition-name { font-size: var(--text-h2); line-height: var(--leading-tight); letter-spacing: var(--tracking-display); margin: 0; }
  .edition-name a { color: var(--ink); text-decoration: none; }
  .edition-name a:hover { color: var(--accent-text); text-decoration: underline; text-decoration-thickness: 3px; text-underline-offset: 6px; }
  .edition-problem { margin: 0; color: var(--ink-2); min-height: 3lh; }
  @media (max-width: 979px) { .edition-problem { min-height: 0; } }
  .start-head { margin: var(--space-2) 0 0; font-size: var(--text-sm); color: var(--ink); }
  .start-list { margin: 0; padding-left: var(--space-5); font-size: var(--text-ui); }
  .start-list li { margin-bottom: var(--space-2); }
  .start-min { color: var(--muted); font-size: var(--text-sm); white-space: nowrap; }
  .edition .btn { align-self: start; justify-self: start; }

  .tools-section { background: var(--bg-2); }
  .split { display: grid; gap: var(--space-5); }
  @media (min-width: 900px) { .split { grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr); gap: var(--space-8); } }
  .split h2 { margin-top: 0; }
  .tools-section .index-list { border-top-color: var(--line-strong); }
  .tools-section .index-list > li { border-bottom-color: var(--line-strong); }

  .why-body .lede { color: var(--ink); }
  .rules { margin: var(--space-5) 0; padding-left: var(--space-5); }
</style>
