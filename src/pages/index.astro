---
import BaseLayout from '../layouts/BaseLayout.astro';
import { REGIONS } from '../lib/regions';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout
  title="LaunchPad — learn how money and business work"
  description="A free learning hub where anyone aged 15 to 21 can learn how money and business work, then practise with calculators. Editions for India, Europe and the United States."
>
  <section class="section intro">
    <div class="container">
      <div class="column">
        <h1>Learn how money and business actually work.</h1>
        <p class="lede">
          LaunchPad is free, has nothing to sell, and is written for people aged 15 to 21
          who don't have an adviser or a family member to ask.
        </p>
        <p>
          Pick where you are. The ideas are the same everywhere, but the examples,
          currencies and rules are not — so each edition is written for the money system
          you actually live in.
        </p>
      </div>

      <ul class="list-plain editions">
        {REGIONS.map((region) => (
          <li>
            <a class="card" href={`${base}/${region.code}`}>
              <h2>{region.name}</h2>
              <p>{region.problem}</p>
              <p class="card-meta">Open this edition</p>
            </a>
          </li>
        ))}
      </ul>

      <div class="column">
        <p class="note" id="resume" hidden>
          <a id="resume-link" href={`${base}/`}>Continue where you left off</a>
        </p>
        <p class="muted small">
          You can switch edition at any time from the tabs at the top of every page.
        </p>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container column">
      <h2>What you get, in every edition</h2>
      <ul>
        <li>Short lessons you can read on a phone, on a slow connection.</li>
        <li>Calculators that work on your own numbers, in your own currency.</li>
        <li>No sign-up, no ads, no tracking, and nothing for sale.</li>
      </ul>
      <p><a href={`${base}/about`}>More about the project</a></p>
    </div>
  </section>
</BaseLayout>

<script>
  // Offer the last edition rather than redirecting: a guess that moves people
  // without asking is the wrong default for a site about not being steered.
  try {
    const saved = window.localStorage.getItem('lp:region');
    const names = { in: 'India', eu: 'Europe', us: 'United States' };
    if (saved && saved in names) {
      const wrap = document.getElementById('resume');
      const link = document.getElementById('resume-link');
      if (wrap && link instanceof HTMLAnchorElement) {
        link.href = new URL(saved, document.baseURI).pathname;
        link.textContent = `Continue with the ${names[saved]} edition`;
        wrap.hidden = false;
      }
    }
  } catch {
    // No stored preference available; the three choices above still work.
  }
</script>

<style>
  .intro { padding-top: var(--space-8); }
  .lede { font-size: 19px; color: var(--ink-2); }
  @media (min-width: 900px) { .lede { font-size: 21px; } }

  .editions { display: grid; gap: var(--space-4); margin: var(--space-7) 0; }
  @media (min-width: 900px) { .editions { grid-template-columns: repeat(3, 1fr); } }
  .editions h2 { margin: 0 0 var(--space-2); font-size: 22px; }
  .editions p { font-size: 16px; }

  li { margin-bottom: var(--space-2); }
  .note { margin-bottom: var(--space-4); }
</style>
