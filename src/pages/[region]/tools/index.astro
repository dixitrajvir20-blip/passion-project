---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { REGIONS, getRegion } from '../../../lib/regions';
import { toolsFor } from '../../../lib/tools';
import { lessonsFor } from '../../../lib/lessons';

export function getStaticPaths() {
  return REGIONS.map((r) => ({ params: { region: r.code } }));
}

const { region: code } = Astro.params;
const region = getRegion(code!);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const prefix = `${base}/${region.code}`;

// "Spot the fake" is built from its lesson's situations, so it exists once that lesson does.
const hasDrill = (await lessonsFor(region.code)).some((lesson) => lesson.data.explorable?.kind === 'drill');
const tools = toolsFor(region.code).filter((tool) => tool.slug !== 'spot-the-fake' || hasDrill);
---

<BaseLayout
  title={`Calculators — LaunchPad ${region.name}`}
  description="Free calculators for break-even, budgeting, savings growth, side-hustle profit and loan repayments. Nothing you type leaves your browser."
  region={region.code}
  regionSub="tools"
  path="tools"
>
  <section class="section">
    <div class="container">
      <div class="column">
        <span class="eyebrow">{region.name} edition</span>
        <h1>Calculators</h1>
        <p class="lede">
          Each one answers a single question using your own numbers. Nothing you type is sent
          anywhere: the maths runs in your browser.
        </p>
      </div>

      <ul class="list-plain tool-list" data-reveal-group>
        {tools.map((tool) => (
          <li data-reveal>
            <a class="card card-arrow" href={`${prefix}/tools/${tool.slug}`}>
              <h2>{tool.title}</h2>
              <p>{tool.answers}</p>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .lede { margin-bottom: var(--space-7); }
  .tool-list { display: grid; gap: var(--space-4); }
  @media (min-width: 640px) { .tool-list { grid-template-columns: repeat(2, 1fr); } }
  .tool-list h2 { font-size: var(--text-h3); padding-right: var(--space-7); }
  .tool-list .card { min-height: 100%; }
</style>
