---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { REGIONS, getRegion } from '../../../lib/regions';
import { toolsFor } from '../../../lib/tools';
import { lessonsFor } from '../../../lib/lessons';

export function getStaticPaths() {
  return REGIONS.map((r) => ({ params: { region: r.code } }));
}

const { region: code } = Astro.params;
const region = getRegion(code!);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const prefix = `${base}/${region.code}`;

// "Spot the fake" is built from its lesson's situations, so it exists once that lesson does.
const hasDrill = (await lessonsFor(region.code)).some((lesson) => lesson.data.explorable?.kind === 'drill');
const tools = toolsFor(region.code).filter((tool) => tool.slug !== 'spot-the-fake' || hasDrill);
---

<BaseLayout
  title={`Tools — Business Lab ${region.name}`}
  description="Free calculators for break-even, budgeting, savings growth, side-hustle profit and loan repayments. Nothing you type leaves your browser."
  region={region.code}
  regionSub="tools"
  path="tools"
>
  <section class="section">
    <div class="container">
      <div class="column">
        <span class="eyebrow">{region.name} edition</span>
        <h1>Tools</h1>
        <p class="lede">
          Calculators that answer one question from your own numbers{hasDrill ? ', and a practice drill' : ''}.
          Nothing you type is sent anywhere: it all runs in your browser.
        </p>
      </div>

      <ul class="index-list tool-index">
        {tools.map((tool) => (
          <li>
            <a class="index-row" href={`${prefix}/tools/${tool.slug}`}>
              <h2 class="index-title">{tool.answers}</h2>
              <span class="index-sub">{tool.title}</span>
              <span class="index-go">Open</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .lede { margin-bottom: var(--space-7); }
  .tool-index { max-width: var(--column); }
  .tool-index .index-title { margin: 0; }
</style>
