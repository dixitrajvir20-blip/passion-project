---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreakEvenTool from '../../../islands/BreakEven.tsx';
import { REGIONS, getRegion } from '../../../lib/regions';

export function getStaticPaths() {
  return REGIONS.map((r) => ({ params: { region: r.code } }));
}

const { region: code } = Astro.params;
const region = getRegion(code!);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const prefix = `${base}/${region.code}`;

const { fixed, variable, price, units, unitName, fixedHint, variableHint, scenario } =
  region.breakEven;
---

<BaseLayout
  title={`Break-even calculator — LaunchPad ${region.name}`}
  description={`Work out how many ${unitName} you need to sell before a small business stops losing money. Free, nothing is sent anywhere.`}
  region={region.code}
  regionSub="tools/break-even"
  path="tools"
>
  <section class="section">
    <div class="container">
      <div class="column">
        <p class="crumb"><a href={`${prefix}/tools`}>← All calculators</a></p>
        <h1>Break-even calculator</h1>
        <p class="answers">
          Answers one question: how many do you have to sell before you stop losing money?
        </p>
        <p class="scenario">It opens on an example — {scenario.toLowerCase()} Change any number to match your own.</p>
      </div>

      {/* client:load, not client:visible — on a phone the tool sits below the fold, and
          a calculator that looks ready but ignores taps is worse than a moment of JS. */}
      <BreakEvenTool
        client:load
        defaults={{ fixed, variable, price, units }}
        unitName={unitName}
        fixedHint={fixedHint}
        variableHint={variableHint}
        localeCode={region.locale}
      />

      <div class="column">
        <p class="note">{region.note}</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .crumb { font-size: var(--text-sm); margin-bottom: var(--space-4); }
  .crumb a { text-decoration: none; }
  .crumb a:hover { text-decoration: underline; }
  .answers { font-size: var(--text-lg); color: var(--ink-2); margin-bottom: var(--space-3); }
  .scenario { color: var(--muted); margin-bottom: var(--space-7); }
  .note { margin-top: var(--space-7); }
</style>
