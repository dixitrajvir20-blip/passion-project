---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import LessonList from '../../../components/lesson/LessonList.astro';
import ProgressMarks from '../../../components/lesson/ProgressMarks.astro';
import { REGIONS, getRegion } from '../../../lib/regions';
import { inTrack, lessonsFor } from '../../../lib/lessons';
import '../../../styles/lesson.css';

export function getStaticPaths() {
  return REGIONS.map((r) => ({ params: { region: r.code } }));
}

const { region: code } = Astro.params;
const region = getRegion(code!);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const prefix = `${base}/${region.code}`;
const lessons = await lessonsFor(region.code);
---

<BaseLayout
  title={`Learn — Business Lab ${region.name}`}
  description={`Three tracks on money, starting a business, and how business works — written for ${region.name}.`}
  region={region.code}
  regionSub="learn"
  path="learn"
>
  <section class="section" data-review-region={region.code}>
    <div class="container">
      <div class="column">
        <h1>Learn</h1>
        <p class="lede">
          Three tracks, written for {region.name}. Start anywhere: each lesson stands on its own and
          takes under ten minutes.
        </p>
        <ProgressMarks reviewHref={`${prefix}/review`} />

        {region.tracks.map((track) => (
          <section class="track" aria-labelledby={`track-${track.slug}`}>
            <h2 id={`track-${track.slug}`}>{track.title}</h2>
            <p class="track-summary">{track.summary}</p>
            <LessonList lessons={inTrack(lessons, track.slug)} planned={track.planned} compact />
            <p class="taxonomy-all"><a href={`${prefix}/learn/${track.slug}`}>Open this track<span class="visually-hidden">: {track.title}</span></a></p>
          </section>
        ))}

        {lessons.length === 0 && (
          <p class="note">
            The {region.name} lessons are being written. The
            <a href={`${prefix}/tools/break-even`}>break-even calculator</a> already works with{' '}
            {region.name} numbers, and the <a href={`${base}/in/learn`}>India edition</a> has the first lessons.
          </p>
        )}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .lede { margin-bottom: var(--space-5); }

  /* One section per track, 48px apart. The first sits under a 1px rule, 32px above its heading;
     after it, each list's own rules divide the tracks, so a second rule would only double them. */
  .track {
    margin-top: var(--space-7);
    padding-top: var(--space-6);
    border-top: var(--rule-w) solid var(--rule);
  }
  .track + .track { border-top: 0; padding-top: 0; }
  .track h2 { margin: 0 0 var(--space-2); }
  .track-summary { margin: 0 0 var(--space-4); color: var(--ink-2); font-size: var(--text-md); }
  /* The way into the track: a standalone link (base.css: ink 700, underlined, 44px) under its list. */
  .taxonomy-all { margin: var(--space-4) 0 0; }

  .note { margin-top: var(--space-8); }
</style>
