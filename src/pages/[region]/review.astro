---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Review from '../../islands/Review.tsx';
import { REGIONS, getRegion } from '../../lib/regions';
import '../../styles/lesson.css';

export function getStaticPaths() {
  return REGIONS.map((r) => ({ params: { region: r.code } }));
}

const { region: code } = Astro.params;
const region = getRegion(code!);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout
  title={`Review — Business Lab ${region.name}`}
  description="Questions from lessons you have finished, brought back a day later and then at longer gaps. It is how the ideas stay."
  region={region.code}
  regionSub="review"
  path="learn"
  noindex
>
  <section class="section">
    <div class="container">
      <div class="column">
        <p class="crumb"><a href={`${base}/${region.code}/learn`}>← All tracks</a></p>
        <h1>Review</h1>
        <p class="lede">
          A few questions from lessons you have finished, brought back after a gap. Answering from
          memory is what makes an idea stay; rereading mostly does not.
        </p>

        <Review client:load region={region.code} checksUrl={`${base}/${region.code}/checks.json`} base={base} localeCode={region.locale} />

        <noscript>
          <p class="note">
            Your review schedule is kept on this device, so this page needs JavaScript. The quick
            check at the end of every lesson works without it.
          </p>
        </noscript>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* The crumb is base.css's. Each question is the lessons' framed .poll (lesson.css). */
  .lede { margin-bottom: var(--space-7); }
  :global(.review-from) { margin-bottom: var(--space-3); color: var(--muted); font-size: var(--text-sm); }
  /* The situation a question was asked about: set apart by a 4px rule at its start, no fill. */
  :global(.review-context) {
    padding-inline-start: var(--space-4);
    border-inline-start: var(--bar-w) solid var(--rule);
    font-size: var(--text-sm);
  }
  :global(.review-action) { margin-top: var(--space-4); }
</style>
