---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { REGIONS, getRegion } from '../../lib/regions';

export function getStaticPaths() {
  return REGIONS.map((r) => ({ params: { region: r.code } }));
}

const { region: code } = Astro.params;
const region = getRegion(code!);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const prefix = `${base}/${region.code}`;
---

<BaseLayout
  title={`Learn — LaunchPad ${region.name}`}
  description={`Three tracks on money, starting a business, and how business works — written for ${region.name}.`}
  region={region.code}
  regionSub="learn"
  path="learn"
>
  <section class="section">
    <div class="container">
      <div class="column">
        <h1>Learn</h1>
        <p class="lede">
          Three tracks, written for {region.name}. Start anywhere — each lesson stands on
          its own and takes under ten minutes.
        </p>
      </div>

      <div class="tracks">
        {region.tracks.map((track) => (
          <article class="track">
            <h2>{track.title}</h2>
            <p>{track.summary}</p>
            <ol class="lessons">
              {track.lessons.map((lesson) => <li>{lesson}</li>)}
            </ol>
          </article>
        ))}
      </div>

      <div class="column">
        <p class="note">
          The lessons are being written, so these titles are the plan rather than finished
          pages. The <a href={`${prefix}/tools/break-even`}>break-even calculator</a> already
          works with {region.name} numbers.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .lede { font-size: 19px; color: var(--ink-2); margin-bottom: var(--space-7); }
  .tracks { display: grid; gap: var(--space-5); }
  @media (min-width: 900px) { .tracks { grid-template-columns: repeat(3, 1fr); } }
  .track {
    background: var(--paper-2);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: var(--space-5);
  }
  .track h2 { margin-top: 0; font-size: 22px; }
  .lessons { margin: 0; padding-left: var(--space-5); color: var(--ink-2); font-size: 16px; }
  .lessons li + li { margin-top: var(--space-2); }
  .note { margin-top: var(--space-7); }
</style>
