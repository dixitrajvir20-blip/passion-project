---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EditionSum from '../../components/EditionSum.astro';
import LessonList from '../../components/lesson/LessonList.astro';
import ProgressMarks from '../../components/lesson/ProgressMarks.astro';
import { REGIONS, getRegion } from '../../lib/regions';
import { groupsFor } from '../../lib/tools';
import { availableTools } from '../../lib/drills';
import { site } from '../../lib/site';
import { inTrack, lessonPath, lessonsFor } from '../../lib/lessons';
import '../../styles/lesson.css';

export function getStaticPaths() {
  return REGIONS.map((r) => ({ params: { region: r.code } }));
}

const { region: code } = Astro.params;
const region = getRegion(code!);
const lessons = await lessonsFor(region.code);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const prefix = `${base}/${region.code}`;
// The first lesson of the first track with one, the natural place to begin.
const first = region.tracks.map((track) => inTrack(lessons, track.slug)[0]).find(Boolean);
// One question per life moment: the first tool this edition has in each group.
const available = await availableTools(region.code);
const questions = groupsFor(region.code, available).map((group) => group.tools[0]);
---

<BaseLayout
  title={`${region.headline.replace(/\.$/, '')} — ${site.name} ${region.name}`}
  description={`Free lessons and calculators on money and business for ages 15 to 21 in ${region.name}. ${region.problem}`}
  region={region.code}
  regionSub=""
>
  <div class="container edition-front">
    <div class="front">
      <section class="intro" aria-labelledby="edition-h">
        <h1 id="edition-h">{region.headline}</h1>
        <p class="lede">{region.intro}</p>
        <div class="btn-row">
          {first ? (
            <a class="btn" href={`${base}/${lessonPath(first)}`}>Start with the first lesson</a>
          ) : (
            <a class="btn" href={`${prefix}/learn`}>See the lessons</a>
          )}
          <a class="btn-link" href={`${prefix}/tools`}>Open the tools</a>
        </div>
      </section>

      <figure class="box example-box">
        <figcaption class="example-label">A worked example</figcaption>
        <EditionSum region={region} />
      </figure>
    </div>

    <section id="lessons" class="column" aria-labelledby="lessons-h" data-review-region={region.code}>
      <h2 id="lessons-h">Lessons</h2>
      <p>Each one stands on its own and takes under ten minutes.</p>
      <ProgressMarks reviewHref={`${prefix}/review`} />
      {region.tracks.map((track) => (
        <section class="front-track" aria-labelledby={`track-${track.slug}`}>
          <h3 id={`track-${track.slug}`}><a href={`${prefix}/learn/${track.slug}`}>{track.title}</a></h3>
          <p class="track-summary">{track.summary}</p>
          <LessonList lessons={inTrack(lessons, track.slug)} planned={track.planned} compact />
        </section>
      ))}
    </section>

    <section id="calculators" class="column taxonomy" aria-labelledby="calc-h">
      <h2 id="calc-h" class="taxonomy-title">Tools that answer</h2>
      <ul class="index-list taxonomy-list">
        {questions.map((tool) => (
          <li><a class="index-row" href={`${prefix}/tools/${tool.slug}`}><span class="index-title">{tool.short}</span></a></li>
        ))}
      </ul>
      <p class="taxonomy-all"><a href={`${prefix}/tools`}>All {available.length} tools</a></p>
      <p class="taxonomy-foot">Calculators set up with {region.name} numbers, and drills of made-up screens. Change any number to match your own.</p>
    </section>

    <section id="why" class="column" aria-labelledby="why-h">
      <h2 id="why-h">Why this edition exists</h2>
      <p>{region.problem}</p>
      <ul class="figures">
        {region.stats.map((stat) => (
          <li class="stat">
            <p class="figure">{stat.figure}</p>
            <p class="stat-label">{stat.label}</p>
            <p class="stat-source">Source: <a href={stat.source.url} rel="noopener noreferrer">{stat.source.title}</a></p>
          </li>
        ))}
      </ul>

      <h3 class="covers-head">What it covers</h3>
      <ul class="covers">
        {region.problems.map((problem) => (
          <li>
            <h4>{problem.title}</h4>
            <p>{problem.body}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="column report-route" aria-labelledby="report-h">
      <h2 id="report-h">If it happens to you</h2>
      <p class="report-text">
        {region.report.text}{' '}
        {region.report.link && <a href={region.report.link.url} rel="noopener noreferrer">{region.report.link.label}</a>}
      </p>
    </section>
    <p class="note column">{region.note}</p>
  </div>
</BaseLayout>

<style>
  /* Flush left on white. From 1024px the worked example sits beside the intro, top-aligned;
     everything after it stays in the 640px column at the left. */
  .edition-front { padding-block: var(--space-section); }
  .front { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-6); align-items: start; }
  @media (min-width: 1024px) { .front { grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); } }
  .edition-front > section { margin-top: var(--space-section); }

  .intro .lede { margin-bottom: var(--space-5); }

  .example-box { margin: 0; max-width: var(--measure); }
  .example-label { margin: 0 0 var(--space-2); color: var(--muted); font-size: var(--text-sm); font-weight: 700; }

  /* Tracks: stacked at every width, each under a hairline, with its numbered lessons. */
  .front-track { margin-top: var(--space-6); padding-top: var(--space-6); border-top: var(--rule-w) solid var(--rule); }
  .front-track h3 { margin-bottom: var(--space-2); }
  .track-summary { margin-bottom: var(--space-4); }

  .taxonomy-all { margin: var(--space-4) 0 0; }
  .taxonomy-all a { display: inline-flex; align-items: center; min-height: var(--target); }
  .taxonomy-foot { margin: var(--space-2) 0 0; color: var(--muted); }

  /* Each statistic is a ruled row carrying its sentence and its source, never a stat banner. */
  .figures { list-style: none; margin: var(--space-5) 0 0; padding: 0; border-bottom: var(--rule-w) solid var(--rule); }
  .stat { margin: 0; padding-block: var(--space-4); border-top: var(--rule-w) solid var(--rule); }
  .stat .figure { margin: 0 0 var(--space-2); font-size: var(--text-h2); }
  .stat-label { margin: 0 0 var(--space-2); }
  .stat-source { margin: 0; color: var(--muted); font-size: var(--text-xs); }
  .stat-source a, .stat-source a:hover { color: inherit; }
  @media (min-width: 768px) {
    .stat { display: grid; grid-template-columns: 10em minmax(0, 1fr); column-gap: var(--space-5); align-items: baseline; }
    .stat .figure { grid-row: 1 / span 2; margin: 0; }
    .stat-label, .stat-source { grid-column: 2; }
  }

  .covers-head { margin-top: var(--space-7); }
  .covers { list-style: none; margin: 0; padding: 0; border-top: var(--rule-w) solid var(--rule); }
  .covers li { margin: 0; padding-block: var(--space-4); border-bottom: var(--rule-w) solid var(--rule); }
  .covers h4 { margin: 0 0 var(--space-1); }
  .covers p { margin: 0; }

  /* The official route to report a scam: plain text under a hairline. */
  .report-route { padding-top: var(--space-6); border-top: var(--rule-w) solid var(--rule); }
  .report-text { margin: 0; color: var(--ink); font-weight: 700; }
  .note { margin: var(--space-6) 0 0; }
</style>
