---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EditionSum from '../../components/EditionSum.astro';
import HandNote from '../../components/HandNote.astro';
import Blobs from '../../components/Blobs.astro';
import Doodle from '../../components/Doodle.astro';
import LessonList from '../../components/lesson/LessonList.astro';
import ProgressMarks from '../../components/lesson/ProgressMarks.astro';
import { REGIONS, getRegion } from '../../lib/regions';
import { toolsFor } from '../../lib/tools';
import { site } from '../../lib/site';
import { inTrack, lessonPath, lessonsFor } from '../../lib/lessons';
import '../../styles/lesson.css';

export function getStaticPaths() {
  return REGIONS.map((r) => ({ params: { region: r.code } }));
}

const { region: code } = Astro.params;
const region = getRegion(code!);
const lessons = await lessonsFor(region.code);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const prefix = `${base}/${region.code}`;
// The first lesson of the first track with one, the natural place to begin.
const first = region.tracks.map((track) => inTrack(lessons, track.slug)[0]).find(Boolean);
const hasDrill = lessons.some((lesson) => lesson.data.explorable?.kind === 'drill');
const tools = toolsFor(region.code).filter((tool) => tool.slug !== 'spot-the-fake' || hasDrill);
const trackDoodles = ['coin', 'tag', 'calculator'] as const;
---

<BaseLayout
  title={`${region.headline.replace(/\.$/, '')} — ${site.name} ${region.name}`}
  description={`Free lessons and calculators on money and business for ages 15 to 21 in ${region.name}. ${region.problem}`}
  region={region.code}
  regionSub=""
  bare
>
  <section class="hero on-field">
    <Blobs />
    <div class="container hero-grid">
      <div>
        <span class="eyebrow">{region.name} edition</span>
        <h1 class="mega">{region.headline}</h1>
        <p class="lede">{region.intro}</p>
        <div class="btn-row">
          {first ? (
            <a class="cta" href={`${base}/${lessonPath(first)}`}><span class="cta-label">Start with the first lesson</span><span class="cta-arrow" aria-hidden="true">→</span></a>
          ) : (
            <a class="cta" href={`${prefix}/learn`}><span class="cta-label">See the lessons</span><span class="cta-arrow" aria-hidden="true">→</span></a>
          )}
          <a class="btn btn-secondary btn-lg" href={`${prefix}/tools`}>Open the calculators</a>
        </div>
      </div>
      <div class="receipt-wrap">
        <div class="receipt">
          <HandNote text="a worked example" tilt="none" class="receipt-note" />
          <EditionSum region={region} />
        </div>
        <p class="sticky-rule" aria-hidden="true">Price − cost = kept</p>
      </div>
    </div>
  </section>

  <section id="lessons" class="sheet contents" aria-labelledby="lessons-h" data-review-region={region.code}>
    <div class="container">
      <div class="centred-head">
        <h2 id="lessons-h">Lessons</h2>
        <p>Each one stands on its own and takes under ten minutes.</p>
        <ProgressMarks reviewHref={`${prefix}/review`} />
      </div>
      <div class="grid-table cols-3 tracks">
        {region.tracks.map((track, index) => (
          <section class="track" aria-labelledby={`track-${track.slug}`}>
            <Doodle name={trackDoodles[index % trackDoodles.length]} class="track-doodle" />
            <h3 id={`track-${track.slug}`}><a href={`${prefix}/learn/${track.slug}`}>{track.title}</a></h3>
            <p class="track-summary">{track.summary}</p>
            <LessonList lessons={inTrack(lessons, track.slug)} planned={track.planned} compact />
          </section>
        ))}
      </div>
    </div>
  </section>

  <section id="calculators" class="section calculators" aria-labelledby="calc-h">
    <div class="container">
      <div class="panel panel-gold taxonomy">
        <h2 id="calc-h" class="taxonomy-title">Calculators that answer</h2>
        <ul class="list-plain taxonomy-list">
          {tools.map((tool) => <li><a href={`${prefix}/tools/${tool.slug}`}>{tool.short}</a></li>)}
        </ul>
        <p class="taxonomy-foot">Set up with {region.name} numbers. Change any of them to match your own.</p>
      </div>
    </div>
  </section>

  <section id="why" class="section why" aria-labelledby="why-h">
    <div class="container">
      <h2 id="why-h" class="centred">Why this edition exists</h2>
      <p class="lede centred why-lede">{region.problem}</p>
      <ul class="list-plain figures">
        {region.stats.map((stat, index) => (
          <li class:list={['stat', { 'stat-gold': index === 1 }]}>
            <p class="figure">{stat.figure}</p>
            <p class="stat-label">{stat.label}</p>
            <p class="stat-source">Source: <a href={stat.source.url} rel="noopener noreferrer">{stat.source.title}</a></p>
          </li>
        ))}
      </ul>

      <h3 class="covers-head">What it covers</h3>
      <ul class="grid-table covers">
        {region.problems.map((problem) => (
          <li>
            <h4>{problem.title}</h4>
            <p>{problem.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section report-section" aria-labelledby="report-h">
    <div class="container">
      <div class="panel section-dark report">
        <div>
          <h2 id="report-h" class="report-title">If it happens to you</h2>
          <p class="report-text">
            {region.report.text}{' '}
            {region.report.link && <a href={region.report.link.url} rel="noopener noreferrer">{region.report.link.label}</a>}
          </p>
        </div>
        <p class="stamp" aria-hidden="true">{region.report.stamp}</p>
      </div>
      <p class="note">{region.note}</p>
    </div>
  </section>
</BaseLayout>

<style>
  .hero { position: relative; overflow: hidden; padding: var(--space-7) 0 var(--space-8); }
  @media (min-width: 900px) { .hero { padding: var(--space-8) 0 var(--space-9); } }
  .hero-grid { position: relative; z-index: 1; display: grid; gap: var(--space-8); align-items: center; }
  @media (min-width: 980px) { .hero-grid { grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); } }
  .hero .eyebrow { margin-bottom: var(--space-4); }
  .hero h1 { font-size: var(--text-display); margin-bottom: var(--space-5); max-width: 16ch; }
  .hero .lede { color: var(--ink-2); margin-bottom: var(--space-6); }

  .receipt-wrap { position: relative; max-width: 420px; width: 100%; justify-self: center; padding-bottom: var(--space-7); }
  .receipt {
    background: var(--paper); color: var(--brand-navy); border: 2px solid var(--brand-navy); border-radius: var(--radius-l);
    padding: var(--space-5); --ink: var(--brand-navy); --ink-2: var(--brand-navy); --muted: var(--brand-navy);
  }
  .receipt :global(.receipt-note) { margin-bottom: var(--space-2); }
  .sticky-rule {
    position: absolute; left: calc(var(--space-5) * -1); bottom: 0; margin: 0; padding: var(--space-3) var(--space-4);
    background: var(--gold); color: var(--on-gold); border: 2px solid var(--brand-navy); border-radius: var(--radius-s);
    font-family: var(--font-display); font-weight: 800; font-size: var(--text-h3);
  }
  @media (max-width: 559px) { .sticky-rule { left: 0; } }

  .centred-head { text-align: center; margin-bottom: var(--space-7); }
  .centred-head h2 { margin: var(--space-2) 0 var(--space-3); font-size: var(--text-h1); }
  .centred-head p { margin: 0 auto; }
  .centred-head :global(.review-line) { margin-top: var(--space-4); }

  .tracks > .track { padding-top: var(--space-7); }
  .track h3 { font-size: var(--text-h2); margin: 0 0 var(--space-2); }
  .track h3 a { color: var(--ink); text-decoration: none; }
  .track h3 a:hover { text-decoration: underline; text-decoration-color: var(--gold); text-decoration-thickness: 4px; }
  .track-summary { font-size: var(--text-ui); color: var(--ink-2); margin-bottom: var(--space-4); }
  .track :global(.track-doodle) { position: absolute; top: calc(var(--space-6) * -0.8); right: var(--space-5); background: var(--bg); }

  .taxonomy { text-align: center; }
  .taxonomy-title { margin: 0 0 var(--space-5); font-size: var(--text-h3); color: var(--on-gold); }
  .taxonomy-list { display: grid; gap: var(--space-2); }
  .taxonomy-list li { margin: 0; }
  .taxonomy-list a {
    font-family: var(--font-display); font-weight: 800; font-size: var(--text-h1); line-height: var(--leading-tight);
    letter-spacing: var(--tracking-display); color: var(--on-gold); text-decoration: none; text-wrap: balance;
  }
  .taxonomy-list a:hover { text-decoration: underline; text-decoration-thickness: 4px; text-underline-offset: 8px; }
  .taxonomy-foot { margin: var(--space-6) auto 0; font-weight: 700; }

  .why { background: var(--field-pale); }
  .centred { text-align: center; margin-left: auto; margin-right: auto; }
  .why h2 { font-size: var(--text-h1); margin-top: 0; }
  .why-lede { max-width: 48ch; }
  .figures { display: grid; gap: var(--space-4); margin: var(--space-7) 0 var(--space-8); }
  @media (min-width: 900px) { .figures { grid-template-columns: repeat(auto-fit, minmax(0, 1fr)); } }
  .stat { margin: 0; padding: var(--space-6); background: var(--bg); border-radius: var(--radius-l); }
  .stat-gold { background: var(--gold); --ink: var(--on-gold); --ink-2: var(--on-gold); --muted: var(--on-gold); --focus: var(--on-gold); color: var(--on-gold); }
  .stat .figure { margin: 0 0 var(--space-3); }
  .stat-label { margin: 0 0 var(--space-4); color: var(--ink); }
  .stat-source { margin: 0; font-size: var(--text-xs); color: var(--muted); }
  .stat-source a { color: inherit; }

  .covers-head { font-size: var(--text-h2); text-align: center; margin: 0 0 var(--space-5); }
  .covers h4 { font-size: var(--text-h3); margin: 0 0 var(--space-2); }
  .covers p { margin: 0; font-size: var(--text-ui); }

  .report-section { padding-top: var(--space-7); }
  .report { display: grid; gap: var(--space-5); align-items: center; }
  @media (min-width: 900px) { .report { grid-template-columns: minmax(0, 1fr) auto; } }
  .report-title { margin: 0 0 var(--space-3); font-size: var(--text-h2); }
  .report-text { margin: 0; font-size: var(--text-lg); color: var(--ink); max-width: 56ch; }
  .report-text a { color: var(--gold); font-weight: 700; }
  .stamp {
    display: grid; place-items: center; width: calc(var(--space-10) + var(--space-5)); aspect-ratio: 1; margin: 0; border-radius: 50%;
    background: var(--gold); color: var(--on-gold); border: 4px solid var(--paper);
    font-family: var(--font-display); font-weight: 800; font-size: var(--text-h2); text-align: center; line-height: 1; transform: rotate(-8deg);
  }
  .note { margin-top: var(--space-6); max-width: var(--column); }
</style>
