---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EditionSum from '../../components/EditionSum.astro';
import LessonList from '../../components/lesson/LessonList.astro';
import ProgressMarks from '../../components/lesson/ProgressMarks.astro';
import { REGIONS, getRegion } from '../../lib/regions';
import { toolsFor } from '../../lib/tools';
import { site } from '../../lib/site';
import { inTrack, lessonPath, lessonsFor } from '../../lib/lessons';
import '../../styles/lesson.css';

export function getStaticPaths() {
  return REGIONS.map((r) => ({ params: { region: r.code } }));
}

const { region: code } = Astro.params;
const region = getRegion(code!);
const lessons = await lessonsFor(region.code);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const prefix = `${base}/${region.code}`;
// The first lesson of the first track, the natural place to begin.
const first = region.tracks.map((track) => inTrack(lessons, track.slug)[0]).find(Boolean);
const hasDrill = lessons.some((lesson) => lesson.data.explorable?.kind === 'drill');
const tools = toolsFor(region.code).filter((tool) => tool.slug !== 'spot-the-fake' || hasDrill);
---

<BaseLayout
  title={`${region.headline.replace(/\.$/, '')} — ${site.name} ${region.name}`}
  description={`Free lessons and calculators on money and business for ages 15 to 21 in ${region.name}. ${region.problem}`}
  region={region.code}
  regionSub=""
>
  <section class="front">
    <div class="container front-grid">
      <div>
        <span class="eyebrow">{region.name} edition</span>
        <h1>{region.headline}</h1>
        <p class="lede">{region.intro}</p>
        <div class="btn-row">
          {first
            ? <a class="btn btn-lg" href={`${base}/${lessonPath(first)}`}>Start with the first lesson</a>
            : <a class="btn btn-lg" href={`${prefix}/learn`}>See the lessons</a>}
          <a class="btn btn-secondary btn-lg" href={`${prefix}/tools`}>Open the calculators</a>
        </div>
      </div>
      <aside class="front-sum" aria-label="A worked example from this edition">
        <EditionSum region={region} />
      </aside>
    </div>
  </section>

  <section id="lessons" class="section contents" aria-labelledby="lessons-h" data-review-region={region.code}>
    <div class="container">
      <div class="section-head">
        <h2 id="lessons-h">Lessons</h2>
        <p>Each one stands on its own and takes under ten minutes.</p>
      </div>
      <ProgressMarks reviewHref={`${prefix}/review`} />
      <div class="tracks">
        {region.tracks.map((track) => (
          <section class="track" aria-labelledby={`track-${track.slug}`}>
            <h3 id={`track-${track.slug}`}><a href={`${prefix}/learn/${track.slug}`}>{track.title}</a></h3>
            <p class="track-summary">{track.summary}</p>
            <LessonList lessons={inTrack(lessons, track.slug)} planned={track.planned} compact />
          </section>
        ))}
      </div>
    </div>
  </section>

  <section id="calculators" class="section calculators" aria-labelledby="calc-h">
    <div class="container split">
      <div>
        <h2 id="calc-h">Calculators</h2>
        <p>Set up with {region.name} numbers. Change any of them to match your own.</p>
      </div>
      <ul class="index-list">
        {tools.map((tool) => (
          <li>
            <a class="index-row" href={`${prefix}/tools/${tool.slug}`}>
              <span class="index-title">{tool.answers}</span>
              <span class="index-sub">{tool.title}</span>
              <span class="index-go" aria-hidden="true">Open</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section id="why" class="section" aria-labelledby="why-h">
    <div class="container">
      <div class="section-head">
        <h2 id="why-h">Why this edition exists</h2>
        <p class="lede">{region.problem}</p>
      </div>

      <ul class="list-plain figures">
        {region.stats.map((stat) => (
          <li class="stat">
            <p class="figure">{stat.figure}</p>
            <div>
              <p class="stat-label">{stat.label}</p>
              <p class="stat-source">
                Source: <a href={stat.source.url} rel="noopener noreferrer">{stat.source.title}</a>
              </p>
            </div>
          </li>
        ))}
      </ul>

      <h3 class="covers-head">What it covers</h3>
      <ul class="list-plain covers">
        {region.problems.map((problem) => (
          <li>
            <h4>{problem.title}</h4>
            <p>{problem.body}</p>
          </li>
        ))}
      </ul>

      <p class="note">{region.note}</p>
    </div>
  </section>
</BaseLayout>

<style>
  .front { padding: var(--space-7) 0 var(--space-8); }
  @media (min-width: 900px) { .front { padding: var(--space-9) 0; } }
  .front-grid { display: grid; gap: var(--space-7); align-items: end; }
  @media (min-width: 980px) { .front-grid { grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: var(--space-8); } }
  .front h1 { max-width: 18ch; }
  .front .btn-row { margin-top: var(--space-6); }
  .front-sum { background: var(--bg-2); border-radius: var(--radius-l); padding: var(--space-5) var(--space-6) var(--space-6); }

  .section-head { max-width: var(--column); margin-bottom: var(--space-5); }
  .section-head h2 { margin-top: 0; }
  .section-head p { margin-bottom: 0; }

  .contents { border-top: 2px solid var(--ink); }
  .tracks { display: grid; gap: var(--space-7); margin-top: var(--space-6); }
  @media (min-width: 980px) { .tracks { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-6); } }
  .track h3 { margin: 0 0 var(--space-2); }
  .track h3 a { color: var(--ink); text-decoration: none; }
  .track h3 a:hover { color: var(--accent-text); text-decoration: underline; }
  .track-summary { font-size: var(--text-ui); margin-bottom: var(--space-4); }
  @media (min-width: 980px) { .track-summary { min-height: 2lh; } }

  .calculators { background: var(--bg-2); }
  .split { display: grid; gap: var(--space-5); }
  @media (min-width: 900px) { .split { grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr); gap: var(--space-8); } }
  .split h2 { margin-top: 0; }
  .calculators .index-list { border-top-color: var(--line-strong); }
  .calculators .index-list > li { border-bottom-color: var(--line-strong); }

  .figures { margin: var(--space-6) 0 var(--space-8); border-top: 1px solid var(--line); }
  .stat { display: grid; gap: var(--space-2) var(--space-6); padding: var(--space-5) 0; border-bottom: 1px solid var(--line); margin: 0; }
  @media (min-width: 720px) { .stat { grid-template-columns: calc(var(--space-10) + var(--space-8)) minmax(0, 1fr); align-items: baseline; } }
  .stat .figure { margin: 0; }
  .stat-label { margin: 0 0 var(--space-2); color: var(--ink); }
  .stat-source { margin: 0; font-size: var(--text-xs); color: var(--muted); }
  .stat-source a { color: var(--muted); }
  .stat-source a:hover { color: var(--accent-text); }

  .covers-head { margin-top: 0; }
  .covers { display: grid; gap: var(--space-5); margin-top: var(--space-4); }
  @media (min-width: 900px) { .covers { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-6) var(--space-8); } }
  .covers li { border-top: 1px solid var(--line); padding-top: var(--space-4); margin: 0; }
  .covers h4 { margin-bottom: var(--space-2); font-size: var(--text-md); }
  .covers p { margin: 0; font-size: var(--text-ui); }
  .note { margin-top: var(--space-8); }
</style>
