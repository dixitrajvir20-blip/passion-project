---
import BaseLayout from '../layouts/BaseLayout.astro';

const terms = [
  { term: 'Break-even', define: 'The point where what you earn covers what you spent, so you are neither losing nor making money.', example: 'A stall with ₹2,000 of monthly costs earning ₹7 per cup breaks even at 286 cups.' },
  { term: 'Capital', define: 'Money put into a business so it can operate or grow.', example: 'Using $50 of savings to buy your first batch of materials is capital.' },
  { term: 'Compound growth', define: 'Growth that builds on earlier growth, because returns are added to the amount that keeps earning.', example: 'Interest earned in year one earns its own interest in year two.' },
  { term: 'Contribution margin', define: 'What is left from one sale after the cost of making that one unit.', example: 'Sell for ₹15, costs ₹8 to make, margin is ₹7 per cup.' },
  { term: 'Fixed cost', define: 'A cost that stays the same no matter how much you sell.', example: 'Stall rent is the same whether you sell 10 cups or 300.' },
  { term: 'Gross margin', define: 'The share of revenue left after the direct cost of what you sold.', example: 'A ₹7 margin on a ₹15 price is a gross margin of about 47%.' },
  { term: 'Inflation', define: 'The general rise in prices over time, which means the same money buys less.', example: 'If prices rise 6% a year, ₹100 buys about ₹94 worth of goods next year.' },
  { term: 'Interest', define: 'The cost of borrowing money, or the payment you receive for lending it.', example: 'A loan at 12% a year costs ₹12 per ₹100 borrowed, per year.' },
  { term: 'Liquidity', define: 'How quickly something can be turned into cash without losing value.', example: 'Money in a savings account is liquid; a half-finished product is not.' },
  { term: 'Margin', define: 'The gap between what something costs you and what you sell it for.', example: 'Buying at 40 and selling at 100 is a margin of 60.' },
  { term: 'Principal', define: 'The original amount borrowed or invested, before interest.', example: 'On a ₹1,00,000 loan, the principal is ₹1,00,000.' },
  { term: 'Profit', define: 'What is left after every cost has been paid.', example: 'Revenue of ₹10,000 with ₹8,000 of costs is ₹2,000 profit.' },
  { term: 'Revenue', define: 'The total money coming in from sales, before any costs are taken out.', example: 'Selling 400 cups at ₹15 is ₹6,000 of revenue.' },
  { term: 'Unit economics', define: 'Whether one single sale makes or loses money, once you account for its costs.', example: 'If one cup costs more to make than it sells for, no amount of volume fixes it.' },
  { term: 'Variable cost', define: 'A cost that rises as you sell more.', example: 'Milk and tea leaves cost more when you make more cups.' },
  { term: 'Working capital', define: 'The money a business needs on hand to run day to day.', example: 'Cash to buy tomorrow ingredients before today sales are collected.' },
].sort((a, b) => a.term.localeCompare(b.term));
---

<BaseLayout
  title="Glossary — LaunchPad"
  description="Plain-language definitions of business and money terms, each with a worked example."
  path="glossary"
>
  <section class="section">
    <div class="container">
      <div class="column">
        <span class="eyebrow">Reference</span>
        <h1>Glossary</h1>
        <p class="lede">
          Every term defined in plain language, with an example. If a lesson uses a word
          that is not here, it should be — tell us.
        </p>
      </div>

      <dl class="terms">
        {terms.map((entry) => (
          <div class="entry">
            <dt>{entry.term}</dt>
            <dd>
              <p>{entry.define}</p>
              <p class="example muted">{entry.example}</p>
            </dd>
          </div>
        ))}
      </dl>

      <div class="column">
        <p class="note">
          {terms.length} terms so far. More are added as lessons are written.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .lede { margin-bottom: var(--space-7); }
  .terms { margin: 0; display: grid; gap: var(--space-4); }
  @media (min-width: 900px) { .terms { grid-template-columns: repeat(2, 1fr); gap: var(--space-5); } }
  .entry {
    border-radius: var(--radius-l);
    background: var(--bg-2);
    padding: var(--space-6);
  }
  dt {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-h3);
    letter-spacing: var(--tracking-heading);
    color: var(--ink);
    margin-bottom: var(--space-2);
  }
  dd { margin: 0; }
  dd p { margin-bottom: var(--space-2); font-size: var(--text-ui); }
  .example { font-size: var(--text-sm); margin-bottom: 0; }
  .note { margin-top: var(--space-7); }
</style>
