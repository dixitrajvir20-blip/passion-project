---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreakEven from '../../islands/BreakEven.tsx';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout
  title="Break-even calculator — LaunchPad"
  description="Work out how many units you need to sell before a small business stops losing money. Free, works offline, supports six currencies."
  path="tools"
>
  <section class="section">
    <div class="container">
      <p class="crumb"><a href={`${base}/tools`}>Tools</a></p>
      <div class="column">
        <h1>Break-even calculator</h1>
        <p class="answers">
          Answers one question: how many do you have to sell before you stop losing money?
        </p>
      </div>

      <BreakEven client:visible />

      <div class="column">
        <p class="note">
          For learning only. Not financial, legal, or tax advice. The numbers it starts with
          are an example, not a prediction of what your idea will earn.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .crumb { font-size: 15px; margin-bottom: var(--space-4); }
  .answers { font-size: 19px; color: var(--ink-2); margin-bottom: var(--space-7); }
  .note { margin-top: var(--space-7); }
</style>
