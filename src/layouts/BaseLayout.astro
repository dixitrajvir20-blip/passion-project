---
import { createHash } from 'node:crypto';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ConsentManager from '../islands/ConsentManager.tsx';
import { site, consentCategories, CONSENT_VERSION } from '../lib/site';
import { REGIONS } from '../lib/regions';
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/base.css';

interface Props {
  title: string;
  description: string;
  path?: string;
  region?: string;
  /** Sub-path the region tabs should preserve when switching edition. */
  regionSub?: string;
  /** Per-edition sub-paths, where an edition lacks this page (a tool it does not have). */
  regionSubs?: Partial<Record<string, string>>;
  /** Social image, relative to the site root. */
  image?: string;
  noindex?: boolean;
  /** Shown beside search results: "Lesson", "Calculator". */
  kind?: string;
  /** Kept for the pages that still pass it; since v5.1 every page is white and it does nothing. */
  bare?: boolean;
}

const { title, description, path = '', region, regionSub = '', regionSubs, image = '/og-default.png', noindex = false, kind } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname, Astro.site);
// Search: an edition's pages are found from that edition; shared pages are found from all of them.
const editions = region ? REGIONS.filter((r) => r.code === region) : REGIONS;
// Every page gets its own share image, drawn from its title at build time (scripts/og-images.mjs)
// and stored under /og/<path-as-slug>.png. Pages that are not for sharing keep the generic one.
const ogSlug = Astro.url.pathname.replace(base, '').replace(/^\/|\/$/g, '').replace(/\//g, '-') || 'home';
const ogPath = image !== '/og-default.png' || noindex ? image : `/og/${ogSlug}.png`;
const ogImage = new URL(`${base}${ogPath}`, Astro.site);

// The optional consent categories in use, for the early banner check below (build-time constants).
const consentIds = consentCategories.filter((c) => c.active).map((c) => c.id).join(' ');

// The first-visit consent banner is a block in the flow under the header, in the server's HTML and
// shown only while html[data-consent-ask] is set. This check sets it, and it has to run before the
// body is parsed: a module script runs after parsing, so the banner could appear after the first
// paint and push the page down. So it is a classic inline script in <head>, and its hash goes into
// the page's CSP here (Astro hashes only the scripts it bundles). It asks when something optional
// is in use, no answer for the current version is stored and Global Privacy Control is off. The
// record is read by the same rules as readConsent and needsPrompt in src/lib/consent.ts, so the two
// agree; the island (src/islands/ConsentManager.tsx) then decides and has the last word.
const consentAsk = `(function () {
  var root = document.documentElement;
  var ids = (root.getAttribute('data-consent-ids') || '').split(' ').filter(Boolean);
  if (ids.length === 0 || navigator.globalPrivacyControl === true) return;
  var version = Number(root.getAttribute('data-consent-version'));
  try {
    var record = JSON.parse(window.localStorage.getItem('lp:consent') || 'null');
    var choices = record && typeof record === 'object' ? record.choices : null;
    var valid = choices && typeof choices === 'object' && !Array.isArray(choices) &&
      typeof record.v === 'number' && (record.source === 'user' || record.source === 'gpc') &&
      Object.keys(choices).every(function (key) { return typeof choices[key] === 'boolean'; });
    if (valid && record.v >= version && ids.every(function (id) { return typeof choices[id] === 'boolean'; })) return;
  } catch (error) {
    // Blocked or unreadable storage: ask.
  }
  root.setAttribute('data-consent-ask', '');
})();`;
Astro.csp?.insertScriptHash(`sha256-${createHash('sha256').update(consentAsk).digest('base64')}`);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.name,
  url: new URL(`${base}/`, Astro.site).toString(),
  description: site.description,
  inLanguage: 'en',
  isAccessibleForFree: true,
  audience: { '@type': 'EducationalAudience', educationalRole: 'student', audienceType: 'ages 15-21' },
  publisher: { '@type': 'Person', name: site.owner },
};
---

<!doctype html>
<html lang="en" data-consent-version={CONSENT_VERSION} data-consent-ids={consentIds}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    {/* The page is light at every OS setting (there is no dark theme); the browser bar continues the blue bar. */}
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content={site.themeColor} />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${base}/icons/icon-192.png`} />
    <link rel="manifest" href={`${base}/manifest.webmanifest`} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preload" href={`${base}/fonts/atkinson-latin.woff2`} as="font" type="font/woff2" crossorigin />
    <script is:inline set:html={consentAsk} />

    {/* Only build-time constants from src/lib/site.ts belong in jsonLd. "<" is escaped anyway so a
        future per-page field can never close the script element. */}
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header region={region} regionSub={regionSub} regionSubs={regionSubs} path={path} />
    {/* The first-visit consent banner is a block in the flow directly under the header, so it never
        covers a focused control. The Privacy choices dialog lives in the same island. */}
    <ConsentManager client:load categories={consentCategories} version={CONSENT_VERSION} />
    {/* data-pagefind-body: only <main> is indexed, so the header, tabs and footer never match a search. */}
    <main id="main" tabindex="-1" data-pagefind-body={noindex ? undefined : ''} data-pagefind-ignore={noindex ? '' : undefined}>
      {!noindex && editions.map((r) => <span data-pagefind-filter={`edition:${r.name}`}></span>)}
      {!noindex && kind && <span data-pagefind-meta={`kind:${kind}`}></span>}
      <slot />
    </main>
    <Footer region={region} />
  </body>
</html>

<script>
  // Lets styles tell a page with scripts from one without; nothing is hidden on the strength of it.
  document.documentElement.classList.add('js');
</script>

<script>
  import { isAllowed, readConsent } from '../lib/consent';
  import { consentCategories } from '../lib/site';
  import { ACTIVITY_KEY, addSeconds, clearActivity, loadActivity, saveActivity } from '../lib/activity';

  // Learning time for the dashboard: seconds per calendar day, on this device, only after a yes in
  // Privacy choices. A later no removes what was kept. Counts only while a page is visible.
  const TICK = 5;
  let storage: Storage | undefined;
  try {
    storage = window.localStorage;
  } catch {
    storage = undefined;
  }
  const check = (add: boolean) => {
    if (!storage) return;
    if (isAllowed(readConsent(storage), 'stats', consentCategories)) {
      if (add) saveActivity(storage, addSeconds(loadActivity(storage), TICK));
    } else if (storage.getItem(ACTIVITY_KEY) !== null) {
      clearActivity(storage);
    }
  };
  window.setInterval(() => document.visibilityState === 'visible' && check(true), TICK * 1000);
  // A no takes effect the moment it is given, not on the next tick.
  document.addEventListener('lp:consent-changed', () => check(false));
  check(false);
</script>
