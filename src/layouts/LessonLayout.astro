---
/**
 * One lesson, as one continuous editorial column. The order follows docs/LEARNING_DESIGN.md
 * (guess, idea, worked example, try it, your turn, quick check, where you'll meet it), but none of
 * those builder's words appear as headings, and nothing here is a card except the gold summary and
 * the explorable. Everything up to the explorable works with JavaScript off.
 */
import { getEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Poll from '../components/lesson/Poll.astro';
import Worked from '../components/lesson/Worked.astro';
import Practice from '../components/lesson/Practice.astro';
import Drill from '../components/lesson/Drill.astro';
import Video from '../components/lesson/Video.astro';
import ShowMe from '../components/lesson/ShowMe.astro';
import Document from '../components/lesson/Document.astro';
import MarginExplorer from '../islands/MarginExplorer.tsx';
import SplitExplorer from '../islands/SplitExplorer.tsx';
import LoanExplorer from '../islands/LoanExplorer.tsx';
import GrowthExplorer from '../islands/GrowthExplorer.tsx';
import DeductionExplorer from '../islands/DeductionExplorer.tsx';
import LessonScript from '../components/lesson/LessonScript.astro';
import { getRegion } from '../lib/regions';
import { site } from '../lib/site';
import { lessonPath, type Lesson } from '../lib/lessons';
import {
  deductionChoices,
  deductionSteps,
  growthChoices,
  growthSteps,
  loanChoices,
  loanSteps,
  marginChoices,
  marginSteps,
  splitChoices,
  splitSteps,
  type Choice,
  type Step,
} from '../lib/lesson-math';
import '../styles/lesson.css';

interface Props {
  lesson: Lesson;
  next?: Lesson;
}

const { lesson, next } = Astro.props;
const d = lesson.data;
const region = getRegion(d.region);
const track = region.tracks.find((t) => t.slug === d.track)!;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const prefix = `${base}/${region.code}`;

const terms = await Promise.all(
  d.glossary.map(async (id) => {
    const entry = await getEntry('glossary', id);
    if (!entry) throw new Error(`${lesson.id}: glossary id "${id}" is not in src/content/glossary/`);
    return entry;
  }),
);

const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();
const year = d.lastReviewed.getFullYear();
// Search engines and reuse tools read the licence from here; people read it at the foot of the page.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LearningResource',
  name: d.title,
  description: d.summary,
  url: pageUrl,
  inLanguage: d.lang,
  isAccessibleForFree: true,
  learningResourceType: 'lesson',
  educationalLevel: d.level,
  timeRequired: `PT${d.readingMinutes}M`,
  dateModified: d.lastReviewed.toISOString().slice(0, 10),
  author: { '@type': 'Person', name: d.author.name },
  publisher: { '@type': 'Organization', name: site.name },
  copyrightHolder: { '@type': 'Person', name: site.owner },
  copyrightYear: year,
  license: site.contentLicence.url,
  audience: { '@type': 'EducationalAudience', educationalRole: 'student', audienceType: 'ages 15-21' },
};

const reviewed = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(d.lastReviewed);

let workedSteps: Step[] = [];
if (d.worked?.kind === 'margin') workedSteps = marginSteps(d.worked, d.worked.unitName);
if (d.worked?.kind === 'split') workedSteps = splitSteps(d.worked);
if (d.worked?.kind === 'loan') workedSteps = loanSteps(d.worked);
if (d.worked?.kind === 'growth') workedSteps = growthSteps(d.worked);
if (d.worked?.kind === 'deduction') workedSteps = deductionSteps(d.worked);

let practice: { given: Step[]; question: string; choices: Choice[] } | null = null;
if (d.practice?.kind === 'margin') {
  practice = {
    given: marginSteps(d.practice, d.practice.unitName).slice(0, 1),
    question: `How many ${d.practice.unitName} cover the month?`,
    choices: marginChoices(d.practice),
  };
}
if (d.practice?.kind === 'loan') {
  practice = { given: loanSteps(d.practice).slice(0, 1), question: 'What does this loan cost in total?', choices: loanChoices(d.practice) };
}
if (d.practice?.kind === 'growth') {
  practice = { given: growthSteps(d.practice).slice(0, 2), question: 'How much of that is growth?', choices: growthChoices(d.practice) };
}
if (d.practice?.kind === 'split') {
  const target = d.practice.target;
  practice = {
    given: splitSteps(d.practice).filter((step) => step.label !== target),
    question: `How much goes to ${target.toLowerCase()}?`,
    choices: splitChoices(d.practice, target),
  };
}
if (d.practice?.kind === 'deduction') {
  practice = {
    given: deductionSteps(d.practice).slice(0, -1),
    question: `What is the ${d.practice.endLabel.toLowerCase()}?`,
    choices: deductionChoices(d.practice),
  };
}

/** Template v2 (22 Sep 2026): the moment and the video first, then the calculation one line at a time. */
const isV2 = d.template === 'v2';
---

<BaseLayout
  title={`${d.title} — Business Lab ${region.name}`}
  description={d.summary}
  region={region.code}
  regionSub="learn"
  path="learn"
  kind="Lesson"
  bare
>
  <Fragment slot="head">
    <link rel="license" href={site.contentLicence.url} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />
  </Fragment>

  <article class:list={['lesson', { 'lesson-v2': isV2 }]} data-lesson-id={lesson.id} data-locale={region.locale}>
    <header class="lesson-head on-field">
      <div class="container">
        <div class="column">
          <p class="lesson-crumbs">
            <a class="pill pill-white" href={`${prefix}/learn/${track.slug}`}>{region.name} · {track.title} · Lesson {d.order}</a>
            <span class="pill">{d.readingMinutes} min</span>
          </p>
          <h1>{d.title}</h1>
          <p class="lede">{d.summary}</p>
          {isV2 && d.objectives && (
            <div class="lesson-after">
              <p class="lesson-after-label">After this you can</p>
              <ul>
                {d.objectives.map((line) => <li>{line}</li>)}
              </ul>
            </div>
          )}
          {!isV2 && (
            <p class="lesson-meta">
              Reviewed {reviewed}. Written by {d.author.name}, {d.author.country}.
            </p>
          )}
          {/* Said before the lesson, not after: the teach-back effect comes from expecting to explain. In v2 the objectives carry it. */}
          {!isV2 && <p class="lesson-expect">Read with a view to explaining it to someone else afterwards. It changes what you notice.</p>}
        </div>
      </div>
    </header>

    <div class="lesson-main sheet">
      <div class="container">
        <div class="column">
          <p class="situation">{d.situation}</p>

          {/* v2: the real document, and a question the reader can answer from it alone. */}
          {isV2 && d.document && (
            <section aria-labelledby="the-document">
              <h2 id="the-document" class="visually-hidden">The document</h2>
              <p class="doc-task">Read it line by line. Tap a line to see what it is. One question follows.</p>
              <Document kind={d.document.kind} title={d.document.title} lines={d.document.lines} />
              <Poll
                id="find"
                question={d.document.find.q}
                options={d.document.find.options}
                answer={d.document.find.answer}
                revealLabel="Show the line"
                label="Find it on the document"
              />
            </section>
          )}

          {!isV2 && (
            <Poll
              id="guess"
              question={d.prediction.q}
              options={d.prediction.options}
              answer={d.prediction.answer}
              revealLabel="Show the answer"
              label="Before you read"
            />
          )}

          {!isV2 && (
            <aside class="callout" aria-labelledby="in-30">
              <h2 id="in-30">Key points</h2>
              <ul>
                {d.takeaways.map((line) => <li>{line}</li>)}
              </ul>
            </aside>
          )}

          {!isV2 && (
            <div class="lesson-body">
              <slot />
            </div>
          )}

          {!isV2 && d.worked && (
            <section aria-labelledby="work-it">
              <h2 id="work-it">The calculation</h2>
              <Worked context={d.worked.context} steps={workedSteps} localeCode={region.locale} />
            </section>
          )}

          {/* v2: watch, then see the same idea as a calculation, one line at a time. */}
          {isV2 && d.video && (
            <section aria-labelledby="watch">
              <h2 id="watch">Watch</h2>
              <Video
                youtubeId={d.video.youtubeId}
                title={d.video.title}
                channel={d.video.channel}
                minutes={d.video.minutes}
                startSeconds={d.video.startSeconds}
                endSeconds={d.video.endSeconds}
                note={d.video.note}
              />
            </section>
          )}

          {isV2 && d.worked && (
            <section aria-labelledby="show-me">
              <h2 id="show-me">Show me</h2>
              <ShowMe context={d.worked.context} steps={workedSteps} localeCode={region.locale} />
            </section>
          )}

          {isV2 && (
            <div class="lesson-body">
              <slot />
            </div>
          )}

          {isV2 && practice && d.practice && (
            <section aria-labelledby="your-turn">
              <h2 id="your-turn">{isV2 ? 'Your turn' : 'Practice'}</h2>
              <Practice
                context={d.practice.context}
                given={practice.given}
                question={practice.question}
                choices={practice.choices}
                localeCode={region.locale}
              />
            </section>
          )}

          {d.explorable && (
            <section aria-labelledby="try-it">
              <h2 id="try-it">{isV2 ? 'Change one thing' : 'Try your own numbers'}</h2>
              {d.explorable.kind === 'margin' && (
                <MarginExplorer
                  client:visible={{ rootMargin: '600px' }}
                  fixed={d.explorable.fixed}
                  variable={d.explorable.variable}
                  prices={d.explorable.prices}
                  unitName={d.explorable.unitName}
                  prompts={d.explorable.prompts}
                  localeCode={region.locale}
                  toolHref={`${prefix}/tools/${d.tool ?? 'break-even'}`}
                  initial={d.worked?.kind === 'margin' ? d.worked.price : undefined}
                />
              )}
              {d.explorable.kind === 'split' && (
                <SplitExplorer
                  client:visible={{ rootMargin: '600px' }}
                  incomes={d.explorable.incomes}
                  lines={d.explorable.lines}
                  prompts={d.explorable.prompts}
                  localeCode={region.locale}
                  toolHref={`${prefix}/tools/${d.tool ?? 'budget'}`}
                />
              )}
              {d.explorable.kind === 'loan' && (
                <LoanExplorer
                  client:visible={{ rootMargin: '600px' }}
                  principal={d.explorable.principal}
                  rate={d.explorable.rate}
                  terms={d.explorable.terms}
                  prompts={d.explorable.prompts}
                  localeCode={region.locale}
                  toolHref={`${prefix}/tools/${d.tool ?? 'loan'}`}
                />
              )}
              {d.explorable.kind === 'growth' && (
                <GrowthExplorer
                  client:visible={{ rootMargin: '600px' }}
                  amounts={d.explorable.amounts}
                  rate={d.explorable.rate}
                  horizons={d.explorable.horizons}
                  prompts={d.explorable.prompts}
                  localeCode={region.locale}
                  toolHref={`${prefix}/tools/${d.tool ?? 'savings'}`}
                />
              )}
              {d.explorable.kind === 'deduction' && (
                <DeductionExplorer
                  client:visible={{ rootMargin: '600px' }}
                  starts={d.explorable.starts}
                  startLabel={d.explorable.startLabel}
                  lines={d.explorable.lines}
                  endLabel={d.explorable.endLabel}
                  prompts={d.explorable.prompts}
                  localeCode={region.locale}
                />
              )}
              {d.explorable.kind === 'drill' && (
                <Drill
                  lessonId={lesson.id}
                  intro={d.explorable.intro}
                  scenarios={d.explorable.scenarios}
                  reflection={d.explorable.reflection}
                  localeCode={region.locale}
                />
              )}
            </section>
          )}

          {!isV2 && practice && d.practice && (
            <section aria-labelledby="your-turn">
              <h2 id="your-turn">{isV2 ? 'Your turn' : 'Practice'}</h2>
              <Practice
                context={d.practice.context}
                given={practice.given}
                question={practice.question}
                choices={practice.choices}
                localeCode={region.locale}
              />
            </section>
          )}

          {isV2 && (
            <section aria-labelledby="for-you">
              <h2 id="for-you">What this means for you</h2>
              <ul class="lesson-actions">
                {d.takeaways.map((line) => <li>{line}</li>)}
              </ul>
            </section>
          )}

          {isV2 && d.details && d.details.length > 0 && (
            <details class="lesson-details">
              <summary>Details, if you want them</summary>
              <ul>
                {d.details.map((line) => <li>{line}</li>)}
              </ul>
            </details>
          )}

          <section aria-labelledby="quick-check">
            <h2 id="quick-check">Check your understanding</h2>
            <p>
              {d.quiz.length} questions, about two minutes. Answer first, then reveal. A question you get
              wrong comes back for review sooner than one you get right.
            </p>
            {d.quiz.map((check, index) => (
              <Poll
                id={`q${index + 1}`}
                question={check.q}
                options={check.options}
                answer={check.answer}
                checkId={`${lesson.id}#q${index + 1}`}
                label={`Question ${index + 1} of ${d.quiz.length}`}
              />
            ))}
            <p class="return-line" data-return-line hidden></p>
          </section>

          <section aria-labelledby="meet-it">
            <h2 id="meet-it">Where this applies</h2>
            <ul>
              {d.transfer.map((line) => <li>{line}</li>)}
            </ul>
            <p>
              To check it has stuck, explain the main idea to someone else in three sentences. Where you
              hesitate is the part worth rereading.
            </p>
          </section>

          {d.reportTo && (
            <section aria-labelledby="if-it-happens">
              <h2 id="if-it-happens">If it happens to you</h2>
              <p class="report">
                {d.reportTo.label}{' '}
                {d.reportTo.phone && (
                  <>
                    Call <a href={`tel:${d.reportTo.phone}`}><strong class="numbers">{d.reportTo.phone}</strong></a> or report at{' '}
                  </>
                )}
                <a href={d.reportTo.url} rel="noopener noreferrer">{new URL(d.reportTo.url).hostname}</a>.
              </p>
            </section>
          )}

          {terms.length > 0 && (
            <section aria-labelledby="terms">
              <h2 id="terms">Terms in this lesson</h2>
              <dl class="lesson-terms">
                {terms.map((entry) => (
                  <div id={`term-${entry.id}`}>
                    <dt lang={entry.data.lang}>{entry.data.term}</dt>
                    <dd>
                      {entry.data.define} <span class="example">{entry.data.example}</span>
                    </dd>
                  </div>
                ))}
              </dl>
              <p><a href={`${base}/glossary`}>The full glossary</a></p>
            </section>
          )}

          {/* Sources and the licence are the same boilerplate on every lesson: keep them out of search. */}
          <footer class="lesson-fine" data-pagefind-ignore>
            {isV2 && (
              <p class="lesson-meta">
                Reviewed {reviewed}. Written by {d.author.name}, {d.author.country}.
              </p>
            )}
            <h2 id="sources">Sources</h2>
            <ul>
              {d.sources.map((source) => (
                <li>
                  <a href={source.url} rel="noopener noreferrer">{source.title}</a>, {source.publisher}
                </li>
              ))}
            </ul>
            <p>For learning only. Not financial, legal, or tax advice. <a href={`${base}/disclaimer`}>Why we say that</a>.</p>

            <h2 id="reuse">Copyright and reuse</h2>
            <p>
              © {year} {site.owner} and Business Lab contributors. You may copy, share and adapt this lesson
              for non-commercial use, such as a class, a club or a handout, as long as you credit it,
              link back, and share your version under the same licence:{' '}
              <a href={site.contentLicence.url} rel="license noopener noreferrer">{site.contentLicence.fullName} ({site.contentLicence.name})</a>.
            </p>
            <p>
              To credit it: “{d.title}”, {site.name}, <span class="cite-url">{pageUrl}</span>.
            </p>
            <p>
              The {site.name} name and logo are not covered by that licence. Documents we link to
              belong to their publishers, and are linked rather than copied for that reason.
            </p>
          </footer>

          <div class="lesson-next">
            {next && (
              <a class="btn btn-link" href={`${base}/${lessonPath(next)}`}>Next: {next.data.title}</a>
            )}
            {!next && <a class="btn btn-link" href={`${prefix}/learn/${track.slug}`}>Back to {track.title}</a>}
            {/* Rendered hidden: with no script it would be a dead control. Never gates anything. */}
            <button type="button" class="btn btn-secondary btn-sm" data-mark-read hidden>Mark as read</button>
            <span class="marked" data-marked role="status"></span>
          </div>
        </div>
      </div>
    </div>

    {/* Definitions for the in-place popover. Hidden unless the Popover API opens one. */}
    {terms.map((entry) => (
      <div class="term-pop" id={`pop-${entry.id}`} popover data-pagefind-ignore>
        <h3 lang={entry.data.lang}>{entry.data.term}</h3>
        <p>{entry.data.define}</p>
        <p class="example">{entry.data.example}</p>
      </div>
    ))}
  </article>
  <LessonScript />
</BaseLayout>
